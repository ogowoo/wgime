    void ImportCodeTable()
    {
        if (inDialog) return;
        inDialog = true;
        bool was = Hook.IsLocked;
        keys = ""; cands.Clear(); Hook.HasCode = false; Hook.IsLocked = false;   // let all keys pass while dialogs are open
        RefreshLabel();
        try {
            string path = null;
            using (var ofd = new OpenFileDialog()) {
                ofd.Filter = L("码表文件 (*.txt;*.dict;*.yaml;*.yml)|*.txt;*.dict;*.yaml;*.yml|所有文件 (*.*)|*.*",
                               "Code tables (*.txt;*.dict;*.yaml;*.yml)|*.txt;*.dict;*.yaml;*.yml|All files (*.*)|*.*");
                ofd.Title = L("选择要导入的码表", "Select a code table to import");
                if (ofd.ShowDialog() != DialogResult.OK) return;
                path = ofd.FileName;
            }
            string text = ReadImportText(path);
            if (text == null) {
                TrayTip(L("导入失败", "Import failed"), L("文件超过 64MB 或无法读取", "File exceeds 64 MB or is unreadable"), ToolTipIcon.Warning);
                return;
            }
            int detected = DetectFormat(text.Split('\n'));
            int target = SuggestTarget(Path.GetFileName(path));
            using (var dlg = new ImportDialog(target, detected)) {
                if (dlg.ShowDialog() != DialogResult.OK) return;
                target = dlg.Target; detected = dlg.Format;
            }
            int fmt = detected == 0 ? 2 : detected;          // undetected -> assume code-first
            string importPath = Path.Combine(BatDir, target == 0 ? "import_wb.txt" : (target == 1 ? "import_py.txt" : "import_ec.txt"));
            System.Threading.Tasks.Task.Run(delegate {
                string summary; bool written = false;
                try {
                    int skipped = 0, truncCodes = 0, truncTotal = 0;
                    var acc = LoadImportBase(importPath);
                    int baseCodes = acc.Count, baseWords = 0;
                    foreach (var kv in acc) baseWords += kv.Value.Count;
                    ConvertFile(text, fmt, acc, ref skipped, ref truncCodes, ref truncTotal);
                    int newCodes = acc.Count - baseCodes, newWords = 0;
                    foreach (var kv in acc) newWords += kv.Value.Count;
                    newWords -= baseWords;
                    string name = Path.GetFileName(importPath);
                    summary = L("新增 ", "Added ") + newCodes + L(" 码 / ", " codes / ") + newWords + L(" 词 → ", " words -> ") + name
                            + L("  (跳过 ", "  (skipped ") + skipped + L(" 行)", " lines)");
                    if (truncCodes > 0 || truncTotal > 0)
                        summary += L("  已截断 ", "  truncated ") + (truncCodes + truncTotal) + L(" 条", " entries");
                    if (newWords <= 0) {
                        try { BeginInvoke((Action)delegate { TrayTip(L("导入码表", "Import Table"),
                            L("没有新增条目（可能已导入过，或格式不匹配）", "Nothing new (already imported, or format mismatch)"), ToolTipIcon.Info); }); } catch {}
                        return;
                    }
                    WriteImportFile(importPath, acc);
                    written = true;
                    var mb = BuildDicts(BatDir);              // full pipeline; import bytes feed the md5 -> wgime.mb rebuilds
                    ApplySwap(mb);
                    try { BeginInvoke((Action)delegate { RefreshLabel(); TrayTip(L("码表导入成功", "Import done"), summary, ToolTipIcon.Info); }); } catch {}
                } catch (Exception ex) {
                    try { BeginInvoke((Action)delegate {
                        if (written) TrayTip(L("导入完成但刷新失败", "Imported but reload failed"),
                            L("重启 WgIme 后生效: ", "Takes effect after restart: ") + ex.Message, ToolTipIcon.Warning);
                        else TrayTip(L("导入失败", "Import failed"), ex.Message, ToolTipIcon.Error);
                    }); } catch {}
                }
            });
        } finally {
            Hook.IsLocked = was; inDialog = false; RefreshLabel();
        }
    }

    // ---------- 固化码表 (bake merged tables into the embedded here-strings) ----------
    static string SerializeDict(Dictionary<string,string> d)   // "code cand1 cand2 ..." per line, sorted
    {
        var ks = d.Keys.ToArray();
        Array.Sort(ks, StringComparer.Ordinal);
        var sb = new StringBuilder();
        foreach (string k in ks) { sb.Append(k).Append(' ').Append(d[k]).Append('\n'); }
        return sb.ToString();
    }
    static bool ReplaceHereString(string bat, string varName, string newBody, out string result)
    {   // replaces the body of "$varName = @'...'@" in the bat text (first "\n'@" after the opener closes it)
        string open = "$" + varName + " = @'";
        int i = bat.IndexOf(open);
        if (i < 0) { result = null; return false; }
        int bodyStart = bat.IndexOf('\n', i) + 1;
        int end = bat.IndexOf("\n'@", bodyStart);
        if (end < 0) { result = null; return false; }
        result = bat.Substring(0, bodyStart) + newBody + bat.Substring(end + 1);
        return true;
    }
    static void DeleteQuiet(string p) { try { if (File.Exists(p)) File.Delete(p); } catch {} }
    static string MakeBakPath(string batPath)   // wgime.bat.bak-yyyyMMdd-HHmmss
    {
        return batPath + ".bak-" + DateTime.Now.ToString("yyyyMMdd-HHmmss");
    }
    static void PruneBaks(string batPath, int keep)   // rolling backup: keep the newest N timestamped copies
    {
        try {
            string dir = Path.GetDirectoryName(batPath);
            string pattern = Path.GetFileName(batPath) + ".bak-" + "???????????????";   // strictly yyyyMMdd-HHmmss (15 chars)
            string[] files = Directory.GetFiles(dir, pattern);
            Array.Sort(files, StringComparer.Ordinal);           // ascending = oldest first (zero-padded timestamp sorts right)
            for (int i = 0; i < files.Length - keep; i++) {
                try { File.Delete(files[i]); } catch {}
            }
        } catch {}
    }

