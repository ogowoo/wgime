        get {
            const int WS_EX_NOACTIVATE=0x08000000, WS_EX_TOOLWINDOW=0x80, WS_EX_TOPMOST=0x8;
            CreateParams cp = base.CreateParams;
            cp.ExStyle |= WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW | WS_EX_TOPMOST;
