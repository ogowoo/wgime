    // ---------- 连续输入 (sentence lattice over dict prefixes) + 联想 (learned commit bigrams) ----------
    static int WfOf(string w) { int n; return WordFreq != null && WordFreq.TryGetValue(w, out n) ? n : 0; }

    // best full-cover path for a concatenated-pinyin string; score = sum(log(w+1)) - edges*LogTotalW (unigram sentence model)
    static string BestSentence(string code)
    {
        int n = code.Length;
        if (n < 4 || n > 32 || PyDict == null) return null;
        var best = new double[n + 1]; var from = new int[n + 1]; var word = new string[n + 1];
        for (int i = 1; i <= n; i++) best[i] = double.NegativeInfinity;
        for (int i = 0; i < n; i++) {
            if (double.IsNegativeInfinity(best[i])) continue;
            for (int len = 1; len <= 12 && i + len <= n; len++) {   // a missing prefix does NOT rule out longer codes (ni..nihao)
                string val;
                if (!PyDict.TryGetValue(code.Substring(i, len), out val)) continue;
                string bw = null; int bwF = -1;
                foreach (string t in val.Split(' ')) { int f = WfOf(t); if (f > bwF) { bwF = f; bw = t; } }
                if (bw == null) continue;
                double sc = best[i] + Math.Log(bwF + 1) - LogTotalW;
                if (sc > best[i + len]) { best[i + len] = sc; from[i + len] = i; word[i + len] = bw; }
            }
        }
        if (double.IsNegativeInfinity(best[n])) return null;
        var parts = new List<string>();
        for (int p = n; p > 0; p = from[p]) parts.Add(word[p]);
        parts.Reverse();
        return string.Join("", parts.ToArray());
    }

    static void LearnAssoc(string prev, string cur)   // personal bigram: prev commit followed by cur commit
    {
        if (!AssocEnabled || Assoc == null) return;
        if (string.IsNullOrEmpty(prev) || string.IsNullOrEmpty(cur) || prev == cur) return;
        if (prev.Length > 8 || cur.Length > 8 || !IsAllCJK(prev) || !IsAllCJK(cur)) return;
        Dictionary<string,int> m;
        if (!Assoc.TryGetValue(prev, out m)) { m = new Dictionary<string,int>(); Assoc[prev] = m; }
        int c; m.TryGetValue(cur, out c); m[cur] = c + 1;
        if (m.Count > 12) {                            // cap per key: drop the weakest
            string weak = null; int wc = int.MaxValue;
            foreach (var kv in m) if (kv.Value < wc) { wc = kv.Value; weak = kv.Key; }
            if (weak != null) m.Remove(weak);
        }
    }

    void ShowAssoc()                                  // offer associations for the last committed word (keys empty)
    {
        assocShowing = false;
        if (AssocEnabled && mode < 3 && lastCommitWord != null && Assoc != null) {
            Dictionary<string,int> m;
            if (Assoc.TryGetValue(lastCommitWord, out m) && m.Count > 0) {
                cands.Clear(); page = 0; dynSet.Clear(); appSet.Clear();
                foreach (var kv in m.OrderByDescending(kv2 => kv2.Value).Take(PageSize)) { cands.Add(kv.Key); dynSet.Add(kv.Key); }
                assocShowing = cands.Count > 0;
                Hook.HasCode = assocShowing;           // route digits/space to the picker while associations show
            }
        }
        RefreshLabel();
    }

    void BeginAssoc(string w)                         // after a word commit: remember it and offer associations
    {
        lastCommitWord = (!string.IsNullOrEmpty(w) && w.Length <= 8 && IsAllCJK(w)) ? w : null;
        ShowAssoc();
    }

    static void SaveAssoc()                           // assoc.txt: prev<TAB>next:cnt ... (top 20000 keys, top 8 nexts)
    {
        try {
            var lines = Assoc.OrderByDescending(kv => kv.Value.Values.Sum()).Take(20000)
                .Select(kv => kv.Key + "\t" + string.Join(" ", kv.Value.OrderByDescending(x => x.Value).Take(8).Select(x => x.Key + ":" + x.Value).ToArray())).ToArray();
            File.WriteAllLines(Path.Combine(DataDir, "assoc.txt"), lines, Encoding.UTF8);
        } catch {}
    }

    static void LoadAssoc()
    {
        try {
            string f = Path.Combine(DataDir, "assoc.txt");
            if (!File.Exists(f)) return;
            foreach (string line in File.ReadAllLines(f, Encoding.UTF8)) {
                int tab = line.IndexOf('\t'); if (tab < 1) continue;
                var m = new Dictionary<string,int>();
                foreach (string t in line.Substring(tab + 1).Split(' ')) {
                    int c = t.LastIndexOf(':'); if (c < 1) continue;
                    int n2; if (int.TryParse(t.Substring(c + 1), out n2)) m[t.Substring(0, c)] = n2;
                }
                if (m.Count > 0) Assoc[line.Substring(0, tab)] = m;
            }
        } catch {}
    }

