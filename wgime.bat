    static string[] AddDynamic(string code, List<string> cands)   // returns the strings it inserted
    {
        string[] dyn = null;
        DateTime n = DateTime.Now;
        if (code == "rq") dyn = new string[] { n.ToString("yyyy-MM-dd"), n.ToString("yyyy年M月d日"), n.ToString("yyyy/MM/dd") };
        else if (code == "sj") dyn = new string[] { n.ToString("HH:mm"), n.ToString("HH:mm:ss"), n.ToString("yyyy-MM-dd HH:mm") };
        else if (code == "xq") dyn = new string[] { "星期" + "日一二三四五六"[(int)n.DayOfWeek], "周" + "日一二三四五六"[(int)n.DayOfWeek] };
        if (dyn == null) return new string[0];
        var added = new List<string>();
        for (int i = dyn.Length - 1; i >= 0; i--) if (!cands.Contains(dyn[i])) { cands.Insert(0, dyn[i]); added.Add(dyn[i]); }
        return added.ToArray();
    }

