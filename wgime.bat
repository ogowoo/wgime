    void BatchMakeWords()
    {
        if (inDialog) return;
        inDialog = true;
        bool was = Hook.IsLocked;
        keys = ""; cands.Clear(); Hook.HasCode = false; Hook.IsLocked = false;   // let all keys pass while dialogs are open
        RefreshLabel();
        try {
            string path = null;
            using (var ofd = new OpenFileDialog()) {
                ofd.Filter = L("文本文件 (*.txt)|*.txt|所有文件 (*.*)|*.*", "Text files (*.txt)|*.txt|All files (*.*)|*.*");
                ofd.Title = L("选择词表文件 (每行一个词)", "Select a word list (one word per line)");
                if (ofd.ShowDialog() != DialogResult.OK) return;
                path = ofd.FileName;
            }
            string text = ReadImportText(path);   // UTF-8 / GB18030 自动识别, 64MB 上限
            if (text == null) {
                TrayTip(L("批量造词", "Batch Make Words"), L("文件超过 64MB 或无法读取", "File exceeds 64 MB or is unreadable"), ToolTipIcon.Warning);
                return;
            }
            var words = new List<string>();
            int skippedLines = CollectWordLines(text, words);
            if (words.Count == 0) {
                TrayTip(L("批量造词", "Batch Make Words"), L("没有发现 2-8 个汉字的词", "No valid words (2-8 hanzi) found"), ToolTipIcon.Warning);
                return;
            }
            using (var dlg = new ConfirmWordsDialog(words.Count, skippedLines)) {
                if (dlg.ShowDialog() != DialogResult.OK) return;
            }
            int added, skipped;
            BatchAddWords(words, out added, out skipped);
            TrayTip(L("批量造词完成", "Batch words done"),
                    L("新增 ", "Added ") + added + L(" 词, 跳过 ", " words, skipped ") + (skipped + skippedLines) + L(" 行", " lines"),
                    ToolTipIcon.Info);
        } finally { inDialog = false; Hook.IsLocked = was; RefreshLabel(); }
    }

