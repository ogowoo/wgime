    static bool emojiVerified;
    static void VerifyEmojiData()   // startup sanity check: panel emoji list must match the embedded PNG array (order + count)
    {
        if (emojiVerified) return;
        emojiVerified = true;
        try {
            string[] panel = SymCats[4].Split(' ');
            if (panel.Length != EmojiChars.Length) {
                KeyBordHook.LogC("emoji mismatch: panel " + panel.Length + " vs pngs " + EmojiChars.Length);
                return;
            }
            for (int i = 0; i < panel.Length; i++)
                if (panel[i] != EmojiChars[i]) { KeyBordHook.LogC("emoji mismatch at index " + i + ": '" + panel[i] + "' vs '" + EmojiChars[i] + "'"); return; }
        } catch {}
    }

