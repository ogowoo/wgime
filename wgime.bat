        string py = (Shuangpin > 0 && mode < 2) ? ShuangpinExpand(keys) : keys;   // shuangpin: typed keys -> full pinyin for the py side
        KeyBordHook.SemiAsCode = (Shuangpin == 3);
        KeyBordHook.DigitAsCode = (Shuangpin == 0 && mode < 2 && keys == "v");     // v-mode: digits extend the code buffer
        if (keys.Length > 0) {
            if (mode == 0) { AddFromDict(WbDict, WbKeys, WbVals, true, keys); AddFromDict(PyDict, PyKeys, PyVals, false, py); }  // mixed: wubi first
            else if (mode == 1) AddFromDict(PyDict, PyKeys, PyVals, false, py);
            else if (mode == 2) AddFromDict(WbDict, WbKeys, WbVals, true, keys);
            else AddTranslate();
            if (mode < 2) {
                AddAcro(py);
                if (cands.Count < PageSize) AddFuzzy(PyDict, py);
            }
            if (cands.Count > 1 && Freq != null && Freq.Count > 0)
                cands = cands.OrderByDescending(w => { int n; return Freq.TryGetValue(w, out n) ? n : 0; }).ToList();
            string lp;
            if (cands.Count > 1 && LastPick != null && LastPick.TryGetValue(keys, out lp) && cands.Contains(lp)) {
                cands.Remove(lp); cands.Insert(0, lp);   // last choice for this code goes first
            }
            if (mode < 3) {
                if (Shuangpin == 0) {
                    foreach (string s in AddDynamic(keys, cands)) dynSet.Add(s);   // rq/sj/xq (raw keys; off under shuangpin to avoid syllable clashes)
                    foreach (string s in AddVMode(keys, cands)) dynSet.Add(s);     // v+digits -> 大写金额 / 千分位
                }
                AddPhrase();                             // config.txt phrase, topmost
                if (mode == 2 && keys.IndexOf('z') >= 0) AddWubiWildcard(keys, cands, WbDict);
            }
        }
        // wubi convention: unique 4-letter code auto-commits (no space needed)
        // ONLY in pure wubi mode - in mixed mode pinyin prefixes collide with wubi codes
        if (mode == 2 && exactWubi && !extendable && keys.Length >= 4 && cands.Count > 0) {
            string s = cands[0];
            string code = keys;
            keys = ""; cands.Clear(); Hook.HasCode = false;
            RefreshLabel();
            Learn(code, s);
            RecordCommit(s, code);
            Send(s);
            return;
        }
        RefreshLabel();
    }

    public void RefreshLabel()
    {
        Visible = Hook.IsLocked;             // hide the bar while in English (capture off)
        tray.Icon = ModeIcon(mode, Hook.IsLocked);
        string modeName = mode == 0 ? L("混合","Mix") : (mode == 1 ? L("拼音","Pin") : (mode == 2 ? L("五笔","Wubi") : L("词典","Dict")));
        StringBuilder sb = new StringBuilder();
        sb.Append("[").Append(modeName).Append("|").Append(Hook.IsLocked ? L("开","ON") : L("关","OFF")).Append("]  ").Append(keys);
        if (cands.Count > 0) {
            int tp = (cands.Count + PageSize - 1) / PageSize;
            if (page >= tp) page = tp - 1; if (page < 0) page = 0;
            sb.Append("   ");
            int start = page * PageSize;
            for (int i = start; i < cands.Count && i < start + PageSize; i++) {
                sb.Append(i - start + 1).Append(".").Append(ToTrad(cands[i]));
                if (ShowCode) {
                    string cd = CodeHint(mode, cands[i]);
                    if (cd != null) sb.Append("(").Append(cd).Append(")");
                }
                sb.Append(' ');
            }
            if (tp > 1) sb.Append("(").Append(page + 1).Append("/").Append(tp).Append(")");
        } else if (!DictsReady) {
            sb.Append(L("   (词库加载中...)", "   (loading dicts...)"));
        } else if (Hook.IsLocked) {
            sb.Append(L("   (Shift开关 Ctrl+`模式 vf符号)", "   (Shift=on/off Ctrl+`mode vf=symbols)"));
        }
        lbl.Text = sb.ToString();
        int w = lbl.BarWidth() + 26;   // auto-fit width (emoji runs measured with Segoe UI Emoji)
        if (w < 180) w = 180;
        int maxW = Screen.PrimaryScreen.WorkingArea.Right - Left - 16;
        if (maxW < 240) maxW = 240;
        if (w > maxW) w = maxW;
        Width = w;
    }

    // ---------- 反查编码提示 ----------
    static string CodeHint(int mode, string w)
    {
        try {
            if (mode == 2) {                       // wubi mode: show pinyin
                string py = CodeFor(w);
                return string.IsNullOrEmpty(py) ? null : py;
            }
            if (RevWb != null) {                   // pinyin/mixed: show wubi code
                string cd;
                return RevWb.TryGetValue(w, out cd) ? cd : null;
            }
        } catch {}
        return null;
    }

    // ---------- elevation helpers for paste fallback ----------
    [DllImport("user32.dll")] static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")] static extern uint GetWindowThreadProcessId(IntPtr hWnd, out int pid);

    // ---------- send to foreground window: hook stays installed, injected keys are ignored via LLKHF_INJECTED ----------
    [DllImport("kernel32.dll")] static extern IntPtr OpenProcess(uint access, bool inherit, int pid);
    [DllImport("advapi32.dll")] static extern bool OpenProcessToken(IntPtr h, uint access, out IntPtr tok);
    [DllImport("advapi32.dll")] static extern bool GetTokenInformation(IntPtr tok, TOKEN_INFORMATION_CLASS cls, out int info, int len, out int retLen);
    [DllImport("kernel32.dll")] static extern bool CloseHandle(IntPtr h);
    enum TOKEN_INFORMATION_CLASS { TokenElevation = 20 }

    static bool SelfElevated()
    {
        try {
            using (var id = WindowsIdentity.GetCurrent())
                return new WindowsPrincipal(id).IsInRole(WindowsBuiltInRole.Administrator);
        } catch { return false; }
    }
    static bool IsElevated(IntPtr hWnd)          // is the foreground window's process elevated?
    {
        try {
            int pid;
            GetWindowThreadProcessId(hWnd, out pid);
            IntPtr h = OpenProcess(0x1000, false, pid);            // PROCESS_QUERY_LIMITED_INFORMATION
            if (h == IntPtr.Zero) return false;
            try {
                IntPtr tok;
                if (!OpenProcessToken(h, 0x8, out tok)) return false;
                try {
                    int elev, size;
                    return GetTokenInformation(tok, TOKEN_INFORMATION_CLASS.TokenElevation, out elev, sizeof(int), out size) && elev != 0;
                } finally { CloseHandle(tok); }
            } finally { CloseHandle(h); }
        } catch { return false; }
    }

    void Send(string msg)
    {
        if (msg.Length == 0) return;
        msg = ToTrad(msg);                             // traditional output toggle applies to every commit path
        sendQueue.Enqueue(msg);
        if (sending) return;                          // a drain pass is already queued: nothing is dropped
        sending = true;
        BeginInvoke((Action)delegate { DrainSendQueue(); });
    }

    void DrainSendQueue()                             // runs on the UI thread, sends commits back-to-back
    {
        try {
            while (sendQueue.Count > 0) {
                string m = sendQueue.Dequeue();
                int mode = EffectiveMode();            // per-process override wins over the global config
                if (mode == 1) PasteCommit(m);
                else if (mode == 0) {                  // auto: clipboard only for elevated targets
                    if (!SelfElevated() && IsElevated(GetForegroundWindow())) PasteCommit(m);
                    else UnicodeCommit(m);
                } else if (mode == 2) SendKeys.Send(Sanitize(m));
                else UnicodeCommit(m);                 // 3 = key (default): per-char KEYEVENTF_UNICODE, no clipboard at all
            }
        } catch (Exception ex) {
            lbl.Text = "[send failed: " + ex.Message + "]";
        } finally {
            sending = false;
        }
    }

    static int FillUnicodeEvents(string text, INPUT[] ins)   // returns event count; surrogate pairs kept together, lone halves skipped
    {
        int n = 0;
        for (int i = 0; i < text.Length; i++) {
            char c = text[i];
            if (char.IsHighSurrogate(c)) {
                if (i + 1 < text.Length && char.IsLowSurrogate(text[i + 1])) {   // astral char: down(hi), down(lo), up(lo), up(hi)
                    ins[n].type = 1; ins[n].u.ki.wScan = c; ins[n].u.ki.dwFlags = 0x4; n++;
                    ins[n].type = 1; ins[n].u.ki.wScan = text[i + 1]; ins[n].u.ki.dwFlags = 0x4; n++;
                    ins[n].type = 1; ins[n].u.ki.wScan = text[i + 1]; ins[n].u.ki.dwFlags = 0x4 | 0x2; n++;
                    ins[n].type = 1; ins[n].u.ki.wScan = c; ins[n].u.ki.dwFlags = 0x4 | 0x2; n++;
                    i++;
                }
                continue;                             // lone high surrogate: skip (would render as garbage)
            }
            if (char.IsLowSurrogate(c)) continue;     // lone low surrogate: skip
            ins[n].type = 1; ins[n].u.ki.wScan = c; ins[n].u.ki.dwFlags = 0x4; n++;
            ins[n].type = 1; ins[n].u.ki.wScan = c; ins[n].u.ki.dwFlags = 0x4 | 0x2; n++;
        }
        return n;
    }
    void UnicodeCommit(string text)                   // per-character Unicode injection: the input queue serializes everything, no shared state
    {
        var ins = new INPUT[text.Length * 2];
        int n = FillUnicodeEvents(text, ins);
        if (n == 0) return;
        if (SendInput((uint)n, ins, Marshal.SizeOf(typeof(INPUT))) != n)
            throw new InvalidOperationException("SendInput failed");
    }

    // ---------- fast paste: one SendInput batch instead of four synchronous keybd_event calls ----------
    [StructLayout(LayoutKind.Sequential)]
    struct MOUSEINPUT { public int dx; public int dy; public uint mouseData; public uint dwFlags; public uint time; public UIntPtr dwExtraInfo; }
    [StructLayout(LayoutKind.Sequential)]
    struct KEYBDINPUT { public ushort wVk; public ushort wScan; public uint dwFlags; public uint time; public UIntPtr dwExtraInfo; }
    [StructLayout(LayoutKind.Sequential)]
    struct HARDWAREINPUT { public uint uMsg; public ushort wParamL; public ushort wParamH; }
    [StructLayout(LayoutKind.Explicit)]
    struct InputUnion { [FieldOffset(0)] public MOUSEINPUT mi; [FieldOffset(0)] public KEYBDINPUT ki; [FieldOffset(0)] public HARDWAREINPUT hi; }
    [StructLayout(LayoutKind.Sequential)]
    struct INPUT { public uint type; public InputUnion u; }
    [DllImport("user32.dll")] static extern uint SendInput(uint n, INPUT[] inputs, int size);

    static string chainPrev, chainLast;           // clipboard restore chain: original captured once per burst
    static int clipGen;                           // generation guard: stale queued restore callbacks become no-ops
    static readonly System.Threading.AutoResetEvent pasteSeen = new System.Threading.AutoResetEvent(false);
    public static int PasteSeenCount;             // diagnostics
    public static void OnInjectedVUp() { PasteSeenCount++; try { pasteSeen.Set(); } catch {} }   // called from the hook when our injected Ctrl+V's V keyup passes through

    void PasteCommit(string text)                // clipboard paste for windows that reject SendKeys (e.g. elevated)
    {
        try {
            if (chainPrev == null) {   // first paste of a burst captures the original (later ones skip the read)
                try { chainPrev = Clipboard.GetText(); } catch {}
                if (chainPrev != null && chainPrev.Length == 0) chainPrev = null;   // non-text/empty original: NEVER restore (restoring empty text would make target pastes drop)
            }
            Clipboard.SetText(text);
            chainLast = text;
            for (int i = 0; i < 6; i++) { Application.DoEvents(); System.Threading.Thread.Sleep(10); }   // 60ms: let clipboard monitors finish their read (they lock the clipboard briefly on update)
            var ins = new INPUT[4];                                // injected Ctrl+V: works for modern apps and elevated targets alike
            for (int i = 0; i < 4; i++) {
                ins[i].type = 1;                                   // INPUT_KEYBOARD
                ins[i].u.ki.wScan = 0;
                ins[i].u.ki.dwFlags = 0;                           // down (last two are keyups below)
            }
            ins[0].u.ki.wVk = 0x11; ins[1].u.ki.wVk = 0x56;        // Ctrl down, V down
            ins[2].u.ki.wVk = 0x56; ins[2].u.ki.dwFlags = 2;       // V up
            ins[3].u.ki.wVk = 0x11; ins[3].u.ki.dwFlags = 2;       // Ctrl up
            pasteSeen.Reset();
            if (SendInput(4, ins, Marshal.SizeOf(typeof(INPUT))) != 4) throw new InvalidOperationException("SendInput failed");
            int waited = 0;                                        // wait until the hook sees the injected V keyup dispatched
            while (waited < 1500) {
                if (pasteSeen.WaitOne(10)) break;
                Application.DoEvents();                            // keep pumping: the hook callback needs our message loop
                waited += 10;
            }
            for (int i = 0; i < 8; i++) { Application.DoEvents(); System.Threading.Thread.Sleep(10); }   // +80ms: cover the target's remaining processing after dispatch
            int g = ++clipGen;
            var old = clipTimer;
            clipTimer = new System.Threading.Timer(delegate(object st) {   // single chain timer: resets per paste, stale callbacks are no-ops
                try { BeginInvoke((Action)delegate {
                    try {
                        if ((int)st != clipGen) return;                    // a newer commit superseded us: do nothing
                        if (chainPrev != null && Clipboard.GetText() == chainLast) Clipboard.SetText(chainPrev);   // restore only if untouched since
                        chainPrev = null; chainLast = null;
                    } catch {}
                }); } catch {}
            }, g, 300, System.Threading.Timeout.Infinite);
            try { if (old != null) old.Dispose(); } catch {}
        } catch {
            try { SendKeys.Send(Sanitize(text)); } catch {}   // fallback
        }
    }

    static string Sanitize(string s)   // escape SendKeys special chars
    {
        StringBuilder sb = new StringBuilder();
        foreach (char ch in s) {
            if ("+^%~(){}[]".IndexOf(ch) >= 0) sb.Append('{').Append(ch).Append('}');
            else sb.Append(ch);
        }
        return sb.ToString();
    }

    // ---------- dict parsing (runs on a background thread; UI starts instantly) ----------
    static void AddDictLine(Dictionary<string,string> d, string raw, bool packChars)
    {
        string t = raw.Trim();
        if (t.Length < 3) return;
        int sp = t.IndexOf(' ');
        if (sp < 1) return;
        string k = t.Substring(0, sp).Trim().ToLower();
        string v = t.Substring(sp + 1).Trim();
        if (k.Length == 0 || v.Length == 0) return;
        if (packChars && v.IndexOf(' ') < 0) {       // embedded table only: packed single chars -> split
            StringBuilder pb = new StringBuilder();
            foreach (char ch in v) { if (pb.Length > 0) pb.Append(' '); pb.Append(ch); }
            v = pb.ToString();
        }
        d[k] = v;
    }

    static Dictionary<string,string> ParseDict(string text, string file, bool packText)
    {
        var d = new Dictionary<string,string>();
        using (var sr = new StringReader(text)) {           // streaming: no Split('\n') giant array for 22MB tables
            string raw;
            while ((raw = sr.ReadLine()) != null) AddDictLine(d, raw, packText);
        }
        try {
            if (!string.IsNullOrEmpty(file) && File.Exists(file))
                foreach (string raw in File.ReadLines(file, Encoding.UTF8)) AddDictLine(d, raw, false);
        } catch {}
        return d;
    }

    // ---------- optimized binary code table (wgime.mb) ----------
    class MbData { public Dictionary<string,string> Py, Wb, Ec, Ce; public string[] Pk, Pv, Wk, Wv, Ek, Ev; public Dictionary<string,List<string>> Acro; }

    static void BuildSorted(Dictionary<string,string> d, out string[] ks, out string[] vs)
    {
        ks = d.Keys.ToArray(); vs = d.Values.ToArray();
        Array.Sort(ks, vs, StringComparer.Ordinal);
    }

    static byte[] InputMd5(string pyText, string wbText, string ecText, byte[] pyFile, byte[] wbFile, byte[] ecFile,
                           byte[] impPy, byte[] impWb, byte[] impEc, byte[] uwFile)
    {
        var md5 = System.Security.Cryptography.MD5.Create();
        Action<byte[]> add = delegate(byte[] b) {   // streaming: same byte sequence as before (data + 0x00 sep), no giant MemoryStream
            if (b != null && b.Length > 0) md5.TransformBlock(b, 0, b.Length, null, 0);
            md5.TransformBlock(new byte[] { 0 }, 0, 1, null, 0);
        };
        add(Encoding.UTF8.GetBytes(pyText)); add(Encoding.UTF8.GetBytes(wbText)); add(Encoding.UTF8.GetBytes(ecText));
        add(pyFile); add(wbFile); add(ecFile); add(impPy); add(impWb); add(impEc); add(uwFile);
        md5.TransformFinalBlock(new byte[0], 0, 0);
        return md5.Hash;
    }

    static void WriteStr(BinaryWriter w, string s) { var b = Encoding.UTF8.GetBytes(s); w.Write((ushort)b.Length); w.Write(b); }
    static string ReadStr(BinaryReader r) { return Encoding.UTF8.GetString(r.ReadBytes(r.ReadUInt16())); }

    static void WriteTable(BinaryWriter w, string[] ks, string[] vs)
    {
        w.Write(ks.Length);
        for (int i = 0; i < ks.Length; i++) { WriteStr(w, ks[i]); WriteStr(w, vs[i]); }
    }

    static void ReadTable(BinaryReader r, out string[] ks, out string[] vs)
    {
        int n = r.ReadInt32(); ks = new string[n]; vs = new string[n];
        for (int i = 0; i < n; i++) { ks[i] = ReadStr(r); vs[i] = ReadStr(r); }
    }

    static Dictionary<string,string> ToMap(string[] ks, string[] vs)
    {
        var d = new Dictionary<string,string>(ks.Length);
        for (int i = 0; i < ks.Length; i++) d[ks[i]] = vs[i];
        return d;
    }

    static void SaveMb(string path, byte[] md5, MbData mb)
    {
        try {
            using (var fs = new FileStream(path, FileMode.Create)) {
                var head = new BinaryWriter(fs);
                head.Write(new byte[] { (byte)'W', (byte)'G', (byte)'M', (byte)'B', (byte)'2' });
                head.Write(md5);
                head.Flush();
                using (var ds = new System.IO.Compression.DeflateStream(fs, System.IO.Compression.CompressionMode.Compress, true))
                using (var w = new BinaryWriter(ds)) {
                    WriteTable(w, mb.Pk, mb.Pv);
                    WriteTable(w, mb.Wk, mb.Wv);
                    WriteTable(w, mb.Ek, mb.Ev);
                    var ck = mb.Ce.Keys.ToArray(); var cv = mb.Ce.Values.ToArray();
                    Array.Sort(ck, cv, StringComparer.Ordinal);
                    WriteTable(w, ck, cv);
                    w.Write(mb.Acro.Count);
                    foreach (var kv in mb.Acro) { WriteStr(w, kv.Key); WriteStr(w, string.Join(" ", kv.Value)); }
                }
            }
        } catch {}
    }

    static MbData TryLoadMb(string path, byte[] wantMd5)
    {
        try {
            using (var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read)) {
                var r0 = new BinaryReader(fs);
                var magic = r0.ReadBytes(5);
                if (magic.Length < 5 || magic[0] != 'W' || magic[1] != 'G' || magic[2] != 'M' || magic[3] != 'B' || magic[4] != '2') return null;
                var md5 = r0.ReadBytes(16);
                if (md5.Length < 16) return null;
                for (int i = 0; i < 16; i++) if (md5[i] != wantMd5[i]) return null;   // sources changed -> rebuild
                var d = new MbData();
                using (var ds = new System.IO.Compression.DeflateStream(fs, System.IO.Compression.CompressionMode.Decompress, true))
                using (var r = new BinaryReader(ds)) {
                    ReadTable(r, out d.Pk, out d.Pv); d.Py = ToMap(d.Pk, d.Pv);
                    ReadTable(r, out d.Wk, out d.Wv); d.Wb = ToMap(d.Wk, d.Wv);
                    ReadTable(r, out d.Ek, out d.Ev); d.Ec = ToMap(d.Ek, d.Ev);
                    string[] ck, cv; ReadTable(r, out ck, out cv); d.Ce = ToMap(ck, cv);
                    int ac = r.ReadInt32();
                    d.Acro = new Dictionary<string,List<string>>(ac);
                    for (int i = 0; i < ac; i++) { string k = ReadStr(r); d.Acro[k] = new List<string>(ReadStr(r).Split(' ')); }
                }
                return d;
            }
        } catch { return null; }
    }

    // ---------- shared dict pipeline (startup + post-import hot reload) ----------
    static byte[] SafeRead(string p) { try { return File.Exists(p) ? File.ReadAllBytes(p) : new byte[0]; } catch { return new byte[0]; } }

    static Dictionary<string,string> LoadImportDict(string f)   // wgime-format import_*.txt
    {
        var d = new Dictionary<string,string>();
        try { if (File.Exists(f)) foreach (string raw in File.ReadLines(f, Encoding.UTF8)) AddDictLine(d, raw, false); } catch {}
        return d;
    }

    static void OverlayImport(Dictionary<string,string> target, Dictionary<string,string> imp)
    {   // existing candidates keep priority (stay first), new ones appended, deduped
        foreach (var kv in imp) {
            string cur;
            if (target.TryGetValue(kv.Key, out cur)) {
                foreach (string w in kv.Value.Split(' ')) {
                    if (w.Length == 0 || (" " + cur + " ").Contains(" " + w + " ")) continue;
                    cur = cur + " " + w;
                }
                target[kv.Key] = cur;
            } else target[kv.Key] = kv.Value;
        }
    }

    static MbData BuildDicts(string dir)   // full pipeline: .mb cache or fresh parse + import overlay + index + save
    {
        lock (DictLock) {
            if (UserWords == null) UserWords = new Dictionary<string,string>();   // pipeline is self-contained
            LoadUserWords();
            byte[] pyF = SafeRead(Path.Combine(dir, "py.txt")), wbF = SafeRead(Path.Combine(dir, "wb.txt")), ecF = SafeRead(Path.Combine(dir, "ec.txt"));
            byte[] ipF = SafeRead(Path.Combine(dir, "import_py.txt")), iwF = SafeRead(Path.Combine(dir, "import_wb.txt")), ieF = SafeRead(Path.Combine(dir, "import_ec.txt"));
            byte[] uwF = SafeRead(Path.Combine(DataDir, "userwords.txt"));
            byte[] md5 = InputMd5(SrcPy, SrcWb, SrcEc, pyF, wbF, ecF, ipF, iwF, ieF, uwF);
            string mbPath = Path.Combine(DataDir, "wgime.mb");
            var mb = TryLoadMb(mbPath, md5);
            if (mb != null) return mb;                        // CharPy is built lazily on first word creation (EnsureCharPy)
            Dictionary<string,string> py = ParseDict(SrcPy, Path.Combine(dir, "py.txt"), true);
            Dictionary<string,string> wb = ParseDict(SrcWb, Path.Combine(dir, "wb.txt"), true);
            Dictionary<string,string> ec = ParseDict(SrcEc, Path.Combine(dir, "ec.txt"), false);
            OverlayImport(py, LoadImportDict(Path.Combine(dir, "import_py.txt")));
            OverlayImport(wb, LoadImportDict(Path.Combine(dir, "import_wb.txt")));
            OverlayImport(ec, LoadImportDict(Path.Combine(dir, "import_ec.txt")));
            MergeUserWords(py);
            Dictionary<string,string> ce = BuildReverse(ec);
            Acro = new Dictionary<string,List<string>>();
            BuildAcro(py);                                            // also rebuilds CharPy
            mb = new MbData { Py = py, Wb = wb, Ec = ec, Ce = ce, Acro = Acro };
            BuildSorted(py, out mb.Pk, out mb.Pv);
            BuildSorted(wb, out mb.Wk, out mb.Wv);
            BuildSorted(ec, out mb.Ek, out mb.Ev);
            SaveMb(mbPath, md5, mb);
            return mb;
        }
    }

    static Dictionary<string,string> BuildRevWb(Dictionary<string,string> wb)   // word -> wubi code (反查)
    {
        var rev = new Dictionary<string,string>();
        if (wb == null) return rev;
        foreach (var kv in wb) foreach (string w in kv.Value.Split(' '))
            if (w.Length > 0 && !rev.ContainsKey(w)) rev[w] = kv.Key;
        return rev;
    }

    static void ApplySwap(MbData mb)   // atomic-ish static swap; Freq/LastPick/UserWords untouched
    {
        PyDict = mb.Py; WbDict = mb.Wb; EcDict = mb.Ec; CeDict = mb.Ce;
        PyKeys = mb.Pk; PyVals = mb.Pv; WbKeys = mb.Wk; WbVals = mb.Wv;
        EcKeys = mb.Ek; EcVals = mb.Ev;
        Acro = mb.Acro;
        if (Freq != null && Freq.Count > 0 && Acro != null)   // 简拼候选按词频降序 (stable), so zg -> 中国 before rare words
            foreach (string k in Acro.Keys.ToArray())
                if (Acro[k].Count > 1)
                    Acro[k] = Acro[k].OrderByDescending(delegate(string w) { int n; return Freq.TryGetValue(w, out n) ? n : 0; }).ToList();
        RevWb = BuildRevWb(mb.Wb);
        DictsReady = true;
    }

    public static void RunApp(string pyText, string wbText, string ecText, string dir, string batPath)
    {
        PyDict = new Dictionary<string,string>(); WbDict = new Dictionary<string,string>();
        EcDict = new Dictionary<string,string>(); CeDict = new Dictionary<string,string>();
        Freq = new Dictionary<string,int>(); Acro = new Dictionary<string,List<string>>();
        LastPick = new Dictionary<string,string>(); UserWords = new Dictionary<string,string>();
