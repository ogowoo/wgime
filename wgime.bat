    // ---------- tray icon: rounded-square tile with the mode char knocked out (hollow), colored=on / gray=off ----------
    static System.Drawing.Drawing2D.GraphicsPath RoundedRect(RectangleF r, float rad)
    {
        var p = new System.Drawing.Drawing2D.GraphicsPath();
        float d = rad * 2;
        p.AddArc(r.X, r.Y, d, d, 180, 90);
        p.AddArc(r.Right - d, r.Y, d, d, 270, 90);
        p.AddArc(r.Right - d, r.Bottom - d, d, d, 0, 90);
        p.AddArc(r.X, r.Bottom - d, d, d, 90, 90);
        p.CloseFigure();
        return p;
    }
    static Icon MakeIcon(string ch, Color c)
    {
        const int S = 64;
        using (var bmp = new Bitmap(S, S)) {
            using (var g = Graphics.FromImage(bmp)) {
                g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;
                g.Clear(Color.Transparent);
                using (var path = RoundedRect(new RectangleF(0, 0, S, S), 14))   // Win11 squircle: ~22% of canvas
                using (var br = new SolidBrush(c)) g.FillPath(br, path);   // tile fills the canvas (rounded corners only)
                using (var gp = new System.Drawing.Drawing2D.GraphicsPath())
                using (var f = new Font("Microsoft YaHei UI", 52, FontStyle.Regular, GraphicsUnit.Pixel)) {
                    var sf = new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center };
                    gp.AddString(ch, f.FontFamily, (int)FontStyle.Regular, 52, new RectangleF(0, 0, S, S), sf);   // char ink ~2px from the tile border
                    g.CompositingMode = System.Drawing.Drawing2D.CompositingMode.SourceCopy;
                    using (var tb = new SolidBrush(Color.Transparent)) g.FillPath(tb, gp);   // knock the char out of the tile
                }
            }
            return Icon.FromHandle(bmp.GetHicon());
        }
    }

    static readonly string[] ModeChars = new string[] { "中", "拼", "五", "译" };
    static readonly Color[] ModeColors = new Color[] {         // Windows 11 system accent palette
        Color.FromArgb(0, 120, 212),     // 混合: 蓝 #0078D4
        Color.FromArgb(0, 183, 195),     // 拼音: 青 #00B7C3
        Color.FromArgb(202, 80, 16),     // 五笔: 橙 #CA5010
        Color.FromArgb(136, 23, 152)     // 词典: 紫 #881798
    };
    static Icon[] onIcons, offIcons;
    static NotifyIcon trayRef;

    static Icon ModeIcon(int m, bool on)
    {
        if (onIcons == null) {
            onIcons = new Icon[4]; offIcons = new Icon[4];
            for (int i = 0; i < 4; i++) {
                onIcons[i] = MakeIcon(ModeChars[i], ModeColors[i]);                      // colored char
                offIcons[i] = MakeIcon(ModeChars[i], Color.FromArgb(190, 185, 179));     // warm gray char #BEB9B3
            }
        }
        return on ? onIcons[m] : offIcons[m];
    }

    // candidate-bar label: GDI+ Label does no font fallback (emoji render as boxes), so paint text run by run:
    // base-font runs keep the GDI+ look; emoji/symbol runs draw with GDI + Segoe UI Emoji (the only way to get color emoji)
    class BarLabel : Label
    {
        internal BarLabel() { try { EmojiFont = new Font("Segoe UI Emoji", 13F); } catch { EmojiFont = null; } }
        Font EmojiFont;

        static bool EmojiAt(string t, int i)
        {
            if (char.IsHighSurrogate(t[i]) && i + 1 < t.Length && char.IsLowSurrogate(t[i + 1])) return true;   // astral -> emoji font
            char c = t[i];
            return (c >= '\u2190' && c <= '\u2BFF') || c == '\uFE0F';   // arrows/misc symbols/dingbats/BMP emoji + VS16
        }
        static List<int[]> Runs(string t)          // {start,end,emoji} per run
        {
            var runs = new List<int[]>();
            int i = 0;
            while (i < t.Length) {
                bool emoji = EmojiAt(t, i);
                int j = i;
                while (j < t.Length && EmojiAt(t, j) == emoji) {
                    if (char.IsHighSurrogate(t[j]) && j + 1 < t.Length && char.IsLowSurrogate(t[j + 1])) j += 2;
                    else j++;
                }
                runs.Add(new int[] { i, j, emoji ? 1 : 0 });
                i = j;
            }
            return runs;
        }
        static readonly TextFormatFlags EmojiFlags = TextFormatFlags.Left | TextFormatFlags.NoPadding | TextFormatFlags.VerticalCenter | TextFormatFlags.NoPrefix;
        protected override void OnPaint(PaintEventArgs e)
        {
            string t = Text;                       // background stays transparent: framework paints the form behind us
            if (t.Length == 0) return;
            int x = Padding.Left;
            using (var sf = new StringFormat(StringFormat.GenericDefault) { LineAlignment = StringAlignment.Center })
            using (var br = new SolidBrush(ForeColor)) {
                foreach (int[] r in Runs(t)) {
                    string seg = t.Substring(r[0], r[1] - r[0]);
                    if (r[2] == 1) {                       // emoji run: embedded color PNG first, GDI mono glyphs as fallback
                        int ih = (int)Math.Round(Font.GetHeight()) + 2;
                        for (int i = r[0]; i < r[1]; ) {
                            int cl = 1; string em;
                            if (char.IsHighSurrogate(t[i]) && i + 1 < r[1] && char.IsLowSurrogate(t[i + 1])) { em = t.Substring(i, 2); cl = 2; }
                            else if (i + 1 < r[1] && t[i + 1] == '\uFE0F' && EmojiImage(t.Substring(i, 2)) != null) { em = t.Substring(i, 2); cl = 2; }
                            else em = t.Substring(i, 1);
                            Bitmap eb = EmojiImage(em);
                            if (eb != null) {
                                int y0 = Padding.Top + (Height - Padding.Vertical - ih) / 2;
                                e.Graphics.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.HighQualityBicubic;
                                e.Graphics.DrawImage(eb, x, y0, ih, ih);
                                x += ih;
                            } else if (EmojiFont != null) {
                                TextRenderer.DrawText(e.Graphics, em, EmojiFont, new Rectangle(x, Padding.Top, Width - x - 2, Height - Padding.Vertical), ForeColor, EmojiFlags);
                                x += TextRenderer.MeasureText(e.Graphics, em, EmojiFont, new Size(10000, 100), EmojiFlags).Width;
                            }
                            i += cl;
                        }
                    } else {
                        e.Graphics.DrawString(seg, Font, br, new RectangleF(x, Padding.Top, Width - x - 2, Height - Padding.Vertical), sf);
                        x += (int)Math.Ceiling(e.Graphics.MeasureString(seg, Font, 10000, StringFormat.GenericDefault).Width);
                    }
                }
            }
        }
        public int BarWidth()
        {
            int w = 0;
            using (var bmp = new Bitmap(1, 1))
            using (var g = Graphics.FromImage(bmp)) {
                foreach (int[] r in Runs(Text)) {
                    string seg = Text.Substring(r[0], r[1] - r[0]);
                    if (r[2] == 1) {
                        int ih = (int)Math.Round(Font.GetHeight()) + 2;
                        for (int i = r[0]; i < r[1]; ) {
                            int cl = 1; string em;
                            if (char.IsHighSurrogate(Text[i]) && i + 1 < r[1] && char.IsLowSurrogate(Text[i + 1])) { em = Text.Substring(i, 2); cl = 2; }
                            else if (i + 1 < r[1] && Text[i + 1] == '\uFE0F' && EmojiImage(Text.Substring(i, 2)) != null) { em = Text.Substring(i, 2); cl = 2; }
                            else em = Text.Substring(i, 1);
                            if (EmojiImage(em) != null) w += ih;
                            else if (EmojiFont != null) w += TextRenderer.MeasureText(em, EmojiFont, new Size(10000, 100), EmojiFlags).Width;
                            i += cl;
                        }
                    } else w += (int)Math.Ceiling(g.MeasureString(seg, Font, 10000, StringFormat.GenericDefault).Width);
                }
            }
            return w;
        }
    }

