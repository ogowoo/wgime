    public static string ToTrad(string s)
    {
        if (!Trad || s == null || s.Length == 0) return s;
        if (TradMap == null) {
            var d = new Dictionary<char,char>(SimpSeq.Length);
            for (int i = 0; i < SimpSeq.Length && i < TradSeq.Length; i++)   // first mapping wins (most common traditional form)
                if (!d.ContainsKey(SimpSeq[i])) d[SimpSeq[i]] = TradSeq[i];
            TradMap = d;
        }
        var sb = new StringBuilder(s.Length);
        foreach (char c in s) { char t; if (TradMap.TryGetValue(c, out t)) sb.Append(t); else sb.Append(c); }
        return sb.ToString();
    }

    static IEnumerable<string> FuzzyVariants(string code)   // single-substitution fuzzy pinyin
    {
        var seen = new HashSet<string>(); int made = 0;
        foreach (var pr in FuzzyPairs) for (int side = 0; side < 2; side++) {
            string from = pr[side], to = pr[1 - side];
            int pos = 0;
            while (made < 16) {
                int at = code.IndexOf(from, pos);
                if (at < 0) break;
                pos = at + 1;
                string v = code.Substring(0, at) + to + code.Substring(at + from.Length);
                if (seen.Add(v)) { made++; yield return v; }
            }
        }
    }

    void AddFuzzy(Dictionary<string,string> d, string code)
    {
        foreach (string v in FuzzyVariants(code)) {
            string exact;
            if (d.TryGetValue(v, out exact)) AddCands(exact);
            if (cands.Count >= CandCap) break;
        }
    }

    static void Learn(string code, string w)   // instant per-code top + frequency counter
    {
        if (string.IsNullOrEmpty(w)) return;
        if (Freq != null) { int n; Freq.TryGetValue(w, out n); Freq[w] = n + 1; }
        if (LastPick != null && !string.IsNullOrEmpty(code)) LastPick[code] = w;
        if (++freqDirty >= 50 || (DateTime.Now - lastFreqSave).TotalSeconds >= 5)   // 50 learns OR 5s elapsed: flush
        { freqDirty = 0; lastFreqSave = DateTime.Now; SaveFreq(); }
    }

    static void SaveFreq()
    {
        try {
            var lines = Freq.OrderByDescending(kv => kv.Value).Take(20000)
                .Select(kv => kv.Key + " " + kv.Value).ToArray();
            File.WriteAllLines(Path.Combine(DataDir, "userdict.txt"), lines, Encoding.UTF8);
            File.WriteAllLines(Path.Combine(DataDir, "lastpick.txt"),
                LastPick.Take(20000).Select(kv => kv.Key + " " + kv.Value).ToArray(), Encoding.UTF8);
        } catch {}
    }

    static void LoadFreq()
    {
        try {
            string f = Path.Combine(DataDir, "userdict.txt");
            if (File.Exists(f))
                foreach (string line in File.ReadAllLines(f, Encoding.UTF8)) {
                    int sp = line.LastIndexOf(' ');
                    if (sp < 1) continue;
                    int n; if (int.TryParse(line.Substring(sp + 1), out n)) Freq[line.Substring(0, sp)] = n;
                }
            string lp = Path.Combine(DataDir, "lastpick.txt");
            if (File.Exists(lp))
                foreach (string line in File.ReadAllLines(lp, Encoding.UTF8)) {
                    int sp = line.IndexOf(' ');
                    if (sp < 1) continue;
                    LastPick[line.Substring(0, sp)] = line.Substring(sp + 1);
                }
        } catch {}
    }

    static void BuildCharPy(Dictionary<string,string> py)
    {
        CharPy = new Dictionary<char,List<string>>();
        foreach (var kv in py) foreach (string w in kv.Value.Split(' ')) {
            if (w.Length != 1) continue;
            List<string> ps;
            if (!CharPy.TryGetValue(w[0], out ps)) { ps = new List<string>(); CharPy[w[0]] = ps; }
            if (!ps.Contains(kv.Key)) ps.Add(kv.Key);
        }
    }

    static void EnsureCharPy()   // lazy: built on first word-creation use, not at startup (cache-hit path skips it)
    {
        if (CharPy != null) return;
        lock (CharPyLock) { if (CharPy == null && PyDict != null) BuildCharPy(PyDict); }
    }

    static void BuildAcro(Dictionary<string,string> py)
    {
        BuildCharPy(py);
        foreach (var kv in py) foreach (string w in kv.Value.Split(' ')) {
            if (w.Length < 2) continue;
            StringBuilder ini = new StringBuilder();
            bool bad = false;
            foreach (char ch in w) {
                List<string> ps;
                if (CharPy.TryGetValue(ch, out ps) && ps.Count > 0) ini.Append(ps[0][0]); else { bad = true; break; }
            }
            if (bad) continue;
            string key = ini.ToString();
            List<string> lst;
            if (!Acro.TryGetValue(key, out lst)) { lst = new List<string>(); Acro[key] = lst; }
            if (lst.Count < 60 && !lst.Contains(w)) lst.Add(w);
        }
    }

    // ---------- 造词 (user word creation) ----------
    static bool IsAllCJK(string s) { foreach (char c in s) if (c < 0x4E00 || c > 0x9FFF) return false; return s.Length > 0; }

    static string CodeFor(string w)              // full pinyin code for a CJK word
    {
        EnsureCharPy();
        if (CharPy == null) return null;
        StringBuilder sb = new StringBuilder();
        foreach (char c in w) {
            List<string> ps;
            if (!CharPy.TryGetValue(c, out ps) || ps.Count == 0) return null;
            sb.Append(ps[0]);
        }
        return sb.ToString();
    }

    static bool AddUserWord(string word, string code, bool quiet)
    {
        EnsureCharPy();
        if (!DictsReady || UserWords.ContainsKey(word) || code == null) return false;
        string cur;
        if (PyDict.TryGetValue(code, out cur) && (" " + cur + " ").Contains(" " + word + " ")) return false;
        UserWords[word] = code;
        // live-inject: dict + sorted arrays + acro index
        if (PyDict.TryGetValue(code, out cur)) PyDict[code] = cur + " " + word; else PyDict[code] = word;
        BuildSorted(PyDict, out PyKeys, out PyVals);
        StringBuilder ini = new StringBuilder(); bool acroOk = true;
        foreach (char c in word) { List<string> ps; if (CharPy.TryGetValue(c, out ps) && ps.Count > 0) ini.Append(ps[0][0]); else { acroOk = false; break; } }
        if (acroOk) {
            List<string> lst;
            if (!Acro.TryGetValue(ini.ToString(), out lst)) { lst = new List<string>(); Acro[ini.ToString()] = lst; }
            if (!lst.Contains(word)) lst.Add(word);
        }
        SaveUserWords();
        if (!quiet && trayRef != null) trayRef.ShowBalloonTip(1800, L("造词成功","Word created"), word + "  (" + code + ")", ToolTipIcon.Info);
        return true;
    }

    static int CollectWordLines(string text, List<string> words)   // 每行一个词: 2-8 汉字, 去重; 返回跳过行数
    {
        var seen = new HashSet<string>();
        int skipped = 0;
        foreach (string raw in text.Split('\n')) {
            string w = raw.Trim();
            if (w.Length == 0) continue;
            if (w.Length < 2 || w.Length > 8 || !IsAllCJK(w)) { skipped++; continue; }
            if (!seen.Add(w)) { skipped++; continue; }
            words.Add(w);
        }
        return skipped;
    }

    static void BatchAddWords(List<string> words, out int added, out int skipped)   // 批量造词: 一次性注入 + 一次排序 + 一次落盘
    {
        added = 0; skipped = 0;
        EnsureCharPy();
        if (!DictsReady || words == null) return;
        var newIni = new Dictionary<string,List<string>>();
        foreach (string word in words) {
            if (UserWords.ContainsKey(word)) { skipped++; continue; }
            string code = CodeFor(word);
            if (code == null) { skipped++; continue; }
            string cur;
            if (PyDict.TryGetValue(code, out cur) && (" " + cur + " ").Contains(" " + word + " ")) { skipped++; continue; }
            UserWords[word] = code;
            if (PyDict.TryGetValue(code, out cur)) PyDict[code] = cur + " " + word; else PyDict[code] = word;
            StringBuilder ini = new StringBuilder(); bool acroOk = true;
            foreach (char c in word) { List<string> ps; if (CharPy.TryGetValue(c, out ps) && ps.Count > 0) ini.Append(ps[0][0]); else { acroOk = false; break; } }
            if (acroOk) {
                List<string> lst;
                if (!newIni.TryGetValue(ini.ToString(), out lst)) { lst = new List<string>(); newIni[ini.ToString()] = lst; }
                if (!lst.Contains(word)) lst.Add(word);
            }
            added++;
        }
        if (added > 0) {
            BuildSorted(PyDict, out PyKeys, out PyVals);
            foreach (var kv in newIni) {
                List<string> lst;
                if (!Acro.TryGetValue(kv.Key, out lst)) { lst = new List<string>(); Acro[kv.Key] = lst; }
                foreach (string w in kv.Value) if (!lst.Contains(w)) lst.Add(w);
            }
            SaveUserWords();
        }
    }

    static void SaveUserWords()
    {
        try {
            var byCode = new Dictionary<string,List<string>>();
            foreach (var kv in UserWords) {
                List<string> l;
                if (!byCode.TryGetValue(kv.Value, out l)) { l = new List<string>(); byCode[kv.Value] = l; }
                l.Add(kv.Key);
            }
            File.WriteAllLines(Path.Combine(DataDir, "userwords.txt"),
                byCode.Select(kv => kv.Key + " " + string.Join(" ", kv.Value)).ToArray(), Encoding.UTF8);
        } catch {}
    }

    static void LoadUserWords()
    {
        try {
            string f = Path.Combine(DataDir, "userwords.txt");
            if (!File.Exists(f)) return;
            foreach (string raw in File.ReadLines(f, Encoding.UTF8)) {
                string t = raw.Trim(); int sp = t.IndexOf(' ');
                if (sp < 1) continue;
                string code = t.Substring(0, sp);
                foreach (string w in t.Substring(sp + 1).Split(' ')) if (w.Length > 0) UserWords[w] = code;
            }
        } catch {}
    }

    static void MergeUserWords(Dictionary<string,string> py)   // startup: bake user words into the dict before indexing
    {
        foreach (var kv in UserWords) {
            string cur;
            if (py.TryGetValue(kv.Value, out cur)) { if (!(" " + cur + " ").Contains(" " + kv.Key + " ")) py[kv.Value] = cur + " " + kv.Key; }
            else py[kv.Value] = kv.Key;
        }
    }

    // recent single-char commits -> auto word creation chain
    class CommitRec { public string Word, Code; public DateTime Ts; }
    static List<CommitRec> recent = new List<CommitRec>();

    void RecordCommit(string w, string code)
    {
        EnsureCharPy();
        if (string.IsNullOrEmpty(w) || w.Length > 4 || !IsAllCJK(w)) { recent.Clear(); return; }
        recent.Add(new CommitRec { Word = w, Code = code, Ts = DateTime.Now });
        if (recent.Count > 6) recent.RemoveAt(0);
        if (w.Length != 1 || CharPy == null) return;
        // longest trailing run of single-char commits (2..4) with verified full-pinyin codes
        int run = 0;
        for (int i = recent.Count - 1; i >= 0; i--) {
            var r = recent[i];
            List<string> ps;
            if (r.Word.Length == 1 && (DateTime.Now - r.Ts).TotalSeconds <= 90
                && CharPy.TryGetValue(r.Word[0], out ps) && ps.Contains(r.Code)) run++;
            else break;
        }
        if (run < 2) return;
        if (run > 4) run = 4;
        StringBuilder nw = new StringBuilder(), nc = new StringBuilder();
        for (int i = recent.Count - run; i < recent.Count; i++) { nw.Append(recent[i].Word); nc.Append(recent[i].Code); }
        recent.Clear();
        AddUserWord(nw.ToString(), nc.ToString(), false);
    }

    void MakeWordFromClipboard()
    {
        try {
            string t = (Clipboard.GetText() ?? "").Trim();
            if (t.Length < 2 || t.Length > 8 || !IsAllCJK(t)) {
                tray.ShowBalloonTip(2000, L("造词","Make Word"), L("先复制 2-8 个汉字，再按 Ctrl+Alt+C","Copy 2-8 hanzi first, then Ctrl+Alt+C"), ToolTipIcon.Warning);
                return;
            }
            string code = CodeFor(t);
            if (!AddUserWord(t, code, false))
                tray.ShowBalloonTip(2000, L("造词","Make Word"), t + L(" 已存在或暂不可造"," already exists"), ToolTipIcon.Info);
        } catch {}
    }

