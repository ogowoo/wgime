    static void FixLegacyConfigIfBroken(string f)   // v1 wrote the template on ONE line (`n artifacts): repair it
    {
        try {
            if (!File.Exists(f)) return;
            string t = File.ReadAllText(f, Encoding.UTF8);
            if (t.Contains("`n") && t.TrimStart().StartsWith(";"))
                File.WriteAllText(f, DefaultConfigText(), new UTF8Encoding(false));
        } catch {}
    }

    static void LoadConfig(string dir)
    {
        Phrases = new Dictionary<string,string>();
        FuzzyPairs = DefaultFuzzyPairs;
        ShowCode = false; PasteMode = 3; Shuangpin = 0; Trad = false; StartOn = true;      // default: per-char Unicode injection (no clipboard, no races)
        try {
            string f = Path.Combine(dir, "config.txt");
            FixLegacyConfigIfBroken(f);
            if (!File.Exists(f)) return;
            foreach (string raw in File.ReadAllLines(f, Encoding.UTF8)) {
                string t = raw.Trim();
                if (t.Length == 0 || t[0] == '#' || t[0] == ';') continue;
                int eq = t.IndexOf('=');
                if (eq < 1) continue;
                string k = t.Substring(0, eq).Trim().ToLower();
                string v = t.Substring(eq + 1).Trim();
                if (k == "fuzzy") {
                    if (v.Length == 0 || v == "none" || v == "off") { FuzzyPairs = new string[0][]; continue; }
                    var list = new List<string[]>();
                    foreach (string pair in v.Split(',')) {
                        string p = pair.Trim();
                        int d = p.IndexOf('-');
                        if (d > 0 && d < p.Length - 1) list.Add(new string[] { p.Substring(0, d).Trim(), p.Substring(d + 1).Trim() });
                    }
                    if (list.Count > 0) FuzzyPairs = list.ToArray();
                } else if (k == "showcode") ShowCode = v == "1" || v == "on" || v == "true";
                else if (k == "paste") PasteMode = (v == "on" || v == "always") ? 1 : (v == "off" ? 2 : (v == "key" || v == "unicode" ? 3 : 0));
                else if (k == "shuangpin") Shuangpin = (v == "xiaohe" || v == "小鹤" || v == "flypy") ? 1 : (v == "ziranma" || v == "自然码" || v == "zrm") ? 2 : (v == "ms" || v == "微软" || v == "mspy") ? 3 : 0;
                else if (k == "trad") Trad = v == "1" || v == "on" || v == "true";
                else if (k == "starton") StartOn = v == "1" || v == "on" || v == "true";
                else if (k == "hotkey_toggle") { if (v == "shift_tap") { KeyBordHook.ModToggle = 0x80000000; KeyBordHook.VkToggle = 0; } else { uint m2, v2; if (KeyBordHook.ParseHotkey(v, out m2, out v2)) { KeyBordHook.ModToggle = m2; KeyBordHook.VkToggle = v2; } } }
                else if (k == "hotkey_mode") { uint m2, v2; if (KeyBordHook.ParseHotkey(v, out m2, out v2)) { KeyBordHook.ModMode = m2; KeyBordHook.VkMode = v2; } }
                else if (k == "hotkey_makeword") { uint m2, v2; if (KeyBordHook.ParseHotkey(v, out m2, out v2)) { KeyBordHook.ModMakeWord = m2; KeyBordHook.VkMakeWord = v2; } }
                else if (k == "hotkey_trad") { uint m2, v2; if (KeyBordHook.ParseHotkey(v, out m2, out v2)) { KeyBordHook.ModTrad = m2; KeyBordHook.VkTrad = v2; } }
                else if (k == "key_first") KeyBordHook.SetKeyConfig(v, ref KeyBordHook.VkFirst);
                else if (k == "key_pageup") KeyBordHook.SetKeyConfig(v, ref KeyBordHook.VkPageUp);
                else if (k == "key_pagedown") KeyBordHook.SetKeyConfig(v, ref KeyBordHook.VkPageDown);
                else if (k == "key_back") KeyBordHook.SetKeyConfig(v, ref KeyBordHook.VkBack);
                else if (k == "key_cancel") KeyBordHook.SetKeyConfig(v, ref KeyBordHook.VkCancel);
                else if (k == "key_raw") KeyBordHook.SetKeyConfig(v, ref KeyBordHook.VkRaw);
                else if (k == "key_pickfirst") KeyBordHook.SetKeyConfig(v, ref KeyBordHook.VkPickFirst);
                else if (k == "key_picklast") KeyBordHook.SetKeyConfig(v, ref KeyBordHook.VkPickLast);
                else if (k == "phrase") {
                    int tab = v.IndexOf('\t'), sp = v.IndexOf(' ');
                    int cut = tab > 0 ? tab : (sp > 0 ? sp : -1);
                    if (cut > 0) {
                        string code = v.Substring(0, cut).Trim().ToLower();
                        string text = v.Substring(cut + 1).Trim();
                        if (code.Length > 0 && text.Length > 0) Phrases[code] = text;
                    }
                }
            }
        } catch {}
    }

    // ---------- per-process paste-mode overrides (auto fallback for apps that ignore Unicode injection) ----------
    static void LoadAppModes()
    {
        AppModes = new Dictionary<string,int>();
        try {
            string f = Path.Combine(DataDir, "pastemode.txt");
            if (!File.Exists(f)) return;
            foreach (string raw in File.ReadAllLines(f, Encoding.UTF8)) {
                string t = raw.Trim();
                if (t.Length == 0 || t[0] == '#') continue;
                int sp = t.IndexOf('=');
                if (sp < 1) continue;
                string name = t.Substring(0, sp).Trim().ToLower();
                string mode = t.Substring(sp + 1).Trim().ToLower();
                int m = (mode == "clipboard" || mode == "on") ? 1 : (mode == "off" || mode == "sendkeys" ? 2 : 3);
                AppModes[name] = m;
            }
        } catch {}
    }
    static void SaveAppModes()
    {
        try {
            var sb = new StringBuilder();
            foreach (var kv in AppModes) sb.Append(kv.Key).Append('=').Append(kv.Value == 1 ? "clipboard" : (kv.Value == 2 ? "sendkeys" : "key")).Append('\n');
            File.WriteAllText(Path.Combine(DataDir, "pastemode.txt"), sb.ToString(), new UTF8Encoding(false));
        } catch {}
    }
    static string ForegroundProcessName()
    {
        try {
            int pid;
            GetWindowThreadProcessId(GetForegroundWindow(), out pid);
            using (var p = Process.GetProcessById(pid)) return p.ProcessName.ToLower();
        } catch { return ""; }
    }
    static int EffectiveMode()
    {
        int m = PasteMode;
        if (AppModes != null) {
            int o;
            if (AppModes.TryGetValue(ForegroundProcessName(), out o)) m = o;
        }
        return m;
    }

    void ToggleAppPasteMode()                        // tray: pin the foreground app to clipboard mode (toggle off restores the default)
    {
        string name = ForegroundProcessName();
        if (name.Length == 0) { TrayTip(L("切换失败", "Switch failed"), L("无法获取当前程序", "cannot get the foreground process"), ToolTipIcon.Warning); return; }
        int cur;
        if (AppModes != null && AppModes.TryGetValue(name, out cur) && cur == 1) {
            AppModes.Remove(name);
            SaveAppModes();
            TrayTip(L("已恢复默认", "Default restored"), name + L(" 将按 config 的上屏方式", " now follows the config paste mode"), ToolTipIcon.Info);
        } else {
            if (AppModes == null) AppModes = new Dictionary<string,int>();
            AppModes[name] = 1;
            SaveAppModes();
            TrayTip(L("已切换", "Switched"), name + L(" 将用剪贴板上屏 (记住此设置)", " now pastes via clipboard (remembered)"), ToolTipIcon.Info);
        }
    }

