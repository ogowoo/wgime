using System.Windows.Forms;

// ===================== keyboard hook (event based, per reference article) =====================
public class KeyBordHook
{
    [DllImport("user32.dll")] static extern IntPtr SetWindowsHookEx(int idHook, HookProc lpfn, IntPtr hInstance, int threadId);
    [DllImport("user32.dll")] static extern bool UnhookWindowsHookEx(IntPtr idHook);
    [DllImport("user32.dll")] static extern IntPtr CallNextHookEx(IntPtr idHook, int nCode, IntPtr wParam, IntPtr lParam);
    [DllImport("kernel32.dll", CharSet=CharSet.Auto)] static extern IntPtr GetModuleHandle(string name);
    [DllImport("user32.dll")] static extern short GetKeyState(int vk);

    internal static void LogC(string m)   // C#-side log to the same %TEMP%\WgIme_error.log as WgLog
    {
        try { File.AppendAllText(Path.Combine(Path.GetTempPath(), "WgIme_error.log"),
            "[" + DateTime.Now.ToString("s") + "] " + m + "\r\n", Encoding.UTF8); } catch {}
    }

    static bool ModifierDown()   // Ctrl / Alt / Win held -> let system shortcuts through
    {
        return (GetKeyState(0x11) & 0x8000) != 0   // VK_CONTROL
            || (GetKeyState(0x12) & 0x8000) != 0   // VK_MENU (Alt)
            || (GetKeyState(0x5B) & 0x8000) != 0   // VK_LWIN
            || (GetKeyState(0x5C) & 0x8000) != 0;  // VK_RWIN
    }

    public delegate IntPtr HookProc(int nCode, IntPtr wParam, IntPtr lParam);
    [StructLayout(LayoutKind.Sequential)]
    public class KeyboardHookStruct { public int vkCode; public int scanCode; public int flags; public int time; public IntPtr dwExtraInfo; }

    const int WH_KEYBOARD_LL = 13, WM_KEYDOWN = 0x100, WM_KEYUP = 0x101;
    IntPtr hKeyboardHook = IntPtr.Zero;
    HookProc proc;
    bool shiftArm = false;

    public bool IsLocked = true;   // capture switch
    public bool HasCode = false;   // hook only needs to know if code buffer is non-empty

    public delegate void KeyUpEventHandler(object sender, KeyEventArgs e);
    public event KeyUpEventHandler KeyUpEvent;   // letter pressed
    public event Action<int> OnSpaced;           // space / digit select (space=0, digits=1..9)
    public event Action OnBacked;                // backspace
    public event Action OnEscaped;               // esc
    public event Action OnEntered;               // enter: commit raw code
    public event Action OnCtrlBackquote;         // Ctrl+` : switch mode (plain ` passes through)
    public event Action OnShiftTap;              // shift tapped alone: IME on/off
    public event Action<int> OnPage;             // candidate page nav (+1 next / -1 prev)
    public event Action<string> OnPunct;         // CN punctuation key mapped
    public event Action OnMakeWord;              // Ctrl+Alt+C : create word from clipboard
    public event Action<int> OnPickChar;         // [ / ] with code buffer: pick first/last char of top candidate
    public event Action OnSemi;                  // bare ; with code (mspy shuangpin: ; = ing)
    public static bool SemiAsCode;               // set by WordBoard when shuangpin == ms
    public event Action<char> OnDigit;           // bare digit appended to the code buffer (v-mode)
    public static bool DigitAsCode;              // set by WordBoard when keys == "v" (v-mode digits)
    public event Action OnToggleTrad;            // simplified/traditional output toggle

    // ---------- 可配置快捷键 (config: hotkey_* / key_*; vk=0 表示禁用; ModToggle=0x80000000 表示 Shift 轻点) ----------
    public static uint ModToggle = 0x80000000, VkToggle = 0;          // shift_tap
    public static uint ModMode = 1, VkMode = 0xC0;                    // Ctrl+`
    public static uint ModMakeWord = 3, VkMakeWord = 0x43;            // Ctrl+Alt+C
    public static uint ModTrad = 5, VkTrad = 0x46;                    // Ctrl+Shift+F
    public static uint VkFirst = 0x20, VkPageUp = 0xBD, VkPageDown = 0xBB;
    public static uint VkBack = 0x08, VkCancel = 0x1B, VkRaw = 0x0D, VkPickFirst = 0xDB, VkPickLast = 0xDD;

    public static uint VkFromName(string n)     // 键名 -> 虚拟键码; 0 = 未知/"none"
    {
        if (n == null) return 0;
        string s = n.Trim().ToLower();
        if (s.Length == 1) {
            char c = s[0];
            if (c >= 'a' && c <= 'z') return (uint)(0x41 + (c - 'a'));
            if (c >= '0' && c <= '9') return (uint)(0x30 + (c - '0'));
            // 其他单字符 (` - = [ ] ; 等) 落入下方命名表
        }
        switch (s) {
            case "space": return 0x20;
            case "enter": case "return": return 0x0D;
            case "esc": case "escape": return 0x1B;
            case "backspace": return 0x08;
            case "tab": return 0x09;
            case "pgup": return 0x21;
            case "pgdn": return 0x22;
            case "home": return 0x24;
            case "end": return 0x23;
            case "left": return 0x25;
            case "right": return 0x27;
            case "up": return 0x26;
            case "down": return 0x28;
            case "grave": case "backquote": case "`": return 0xC0;
            case "minus": case "-": return 0xBD;
            case "plus": case "equals": case "=": return 0xBB;
            case "lbracket": case "[": return 0xDB;
            case "rbracket": case "]": return 0xDD;
            case "semicolon": case ";": return 0xBA;
            case "quote": case "'": return 0xDE;
            case "comma": case ",": return 0xBC;
            case "period": case ".": return 0xBE;
            case "slash": case "/": return 0xBF;
            case "backslash": case "\\": return 0xDC;
        }
        if (s.Length >= 2 && s[0] == 'f') {
            int fn;
            if (int.TryParse(s.Substring(1), out fn) && fn >= 1 && fn <= 12) return (uint)(0x6F + fn);
        }
        return 0;
    }

    public static bool ParseHotkey(string v, out uint mods, out uint vk)   // "ctrl+alt+c"; "none" = 禁用; 失败不改
    {
        if (v == null) { mods = 0; vk = 0; return false; }
        string t = v.Trim().ToLower();
        if (t == "none") { mods = 0; vk = 0; return true; }
        uint m = 0, k = 0;
        foreach (string p in t.Split('+')) {
            string q = p.Trim();
            if (q == "ctrl" || q == "control") m |= 1;
            else if (q == "alt" || q == "menu") m |= 2;
            else if (q == "shift") m |= 4;
            else if (q == "win" || q == "windows") m |= 8;
            else {
                uint kv = VkFromName(q);
                if (kv == 0 || k != 0) { mods = 0; vk = 0; return false; }
                k = kv;
            }
        }
        if (k == 0) { mods = 0; vk = 0; return false; }
        mods = m; vk = k;
        return true;
    }

    public static void SetKeyConfig(string v, ref uint field)   // key_* 解析: "none" 禁用, 无效值忽略
    {
        if (v == "none") { field = 0; return; }
        uint kv = VkFromName(v);
        if (kv != 0) field = kv;
    }

    static bool MatchMods(uint mods)            // 严格匹配: 有标志的修饰键必须按下, 其余必须抬起
    {
        bool c = (GetKeyState(0x11) & 0x8000) != 0;
        bool a = (GetKeyState(0x12) & 0x8000) != 0;
        bool s = (GetKeyState(0x10) & 0x8000) != 0;
        bool w = (GetKeyState(0x5B) & 0x8000) != 0 || (GetKeyState(0x5C) & 0x8000) != 0;
        return (((mods & 1) != 0) == c) && (((mods & 2) != 0) == a) && (((mods & 4) != 0) == s) && (((mods & 8) != 0) == w);
    }

    static bool sqOpen, dqOpen;                  // quote alternation state

    static string MapPunct(int vk, bool sh)      // CN punctuation map (null = pass through)
    {
        switch (vk) {
            case 0xBC: return sh ? "《" : "，";   // , <
            case 0xBE: return sh ? "》" : "。";   // . >
            case 0xBA: return sh ? "：" : "；";   // ; :
            case 0xBF: return sh ? "？" : null;   // / ?
            case 0xDC: return sh ? null : "、";   // \ |
            case 0xDB: return sh ? null : "【";   // [ {
            case 0xDD: return sh ? null : "】";   // ] }
            case 0x34: return sh ? "¥" : null;   // $ -> ¥
            case 0xDE:                            // ' "
                if (sh) { dqOpen = !dqOpen; return dqOpen ? "“" : "”"; }
                sqOpen = !sqOpen; return sqOpen ? "‘" : "’";
        }
        return null;
    }

    public void Start()
    {
        if (hKeyboardHook == IntPtr.Zero)
        {
            proc = new HookProc(KeyboardHookProc);
            hKeyboardHook = SetWindowsHookEx(WH_KEYBOARD_LL, proc,
                GetModuleHandle(Process.GetCurrentProcess().MainModule.ModuleName), 0);
        }
    }

    public void Stop()
    {
        if (hKeyboardHook != IntPtr.Zero)
        {
            UnhookWindowsHookEx(hKeyboardHook);
            hKeyboardHook = IntPtr.Zero;
        }
    }

    public bool Installed { get { return hKeyboardHook != IntPtr.Zero; } }

    IntPtr KeyboardHookProc(int nCode, IntPtr wParam, IntPtr lParam)
    {
        if (nCode < 0) return CallNextHookEx(hKeyboardHook, nCode, wParam, lParam);
        int msg = wParam.ToInt32();
        if (msg != WM_KEYDOWN && msg != WM_KEYUP)
            return CallNextHookEx(hKeyboardHook, nCode, wParam, lParam);

        KeyboardHookStruct k = (KeyboardHookStruct)Marshal.PtrToStructure(lParam, typeof(KeyboardHookStruct));
        if ((k.flags & 0x10) != 0) {                     // LLKHF_INJECTED: sent by ourselves (SendInput/SendKeys) -> pass through
            if (msg == WM_KEYUP && k.vkCode == 0x56) WordBoard.OnInjectedVUp();   // our injected Ctrl+V's V keyup = the target consumed the paste
            return CallNextHookEx(hKeyboardHook, nCode, wParam, lParam);
        }

        bool isShift = (k.vkCode == 160 || k.vkCode == 161);
        bool shiftTap = (ModToggle == 0x80000000);

        if (msg == WM_KEYUP)                             // shift released with nothing in between -> CN/EN tap
        {
            if (shiftTap && isShift && shiftArm) {
                shiftArm = false;
                if (OnShiftTap != null) OnShiftTap();
            }
            return CallNextHookEx(hKeyboardHook, nCode, wParam, lParam);
        }

        try {
            if (isShift) { if (shiftTap) shiftArm = true; return CallNextHookEx(hKeyboardHook, nCode, wParam, lParam); }
            shiftArm = false;                            // any other key breaks the shift tap

            if (VkToggle != 0 && k.vkCode == VkToggle && MatchMods(ModToggle))   // 开关输入法 (通用热键形式)
            {
                if (OnShiftTap != null) OnShiftTap();
                return (IntPtr)1;
            }
            if (VkMode != 0 && k.vkCode == VkMode && MatchMods(ModMode))         // 切换模式
            {
                if (OnCtrlBackquote != null) OnCtrlBackquote();
                return (IntPtr)1;
            }
            if (VkMakeWord != 0 && k.vkCode == VkMakeWord && MatchMods(ModMakeWord))   // 造词
            {
                if (OnMakeWord != null) OnMakeWord();
                return (IntPtr)1;
            }
            if (VkTrad != 0 && k.vkCode == VkTrad && MatchMods(ModTrad))         // 简繁切换
            {
                if (OnToggleTrad != null) OnToggleTrad();
                return (IntPtr)1;
            }
            if (IsLocked)
            {
                bool bare = !ModifierDown();                 // only intercept keys without Ctrl/Alt/Win
                bool sh = (GetKeyState(0x10) & 0x8000) != 0; // Shift held
                if (bare && HasCode && k.vkCode >= 48 && k.vkCode <= 57)      // 1-9 select (0 unused); v-mode: digits extend the code
                {
                    if (k.vkCode > 48) {
                        if (DigitAsCode && OnDigit != null) OnDigit((char)k.vkCode);
                        else if (OnSpaced != null) OnSpaced(k.vkCode - 48);
                    }
                    return (IntPtr)1;
                }
                if (bare && HasCode && VkBack != 0 && k.vkCode == VkBack) { if (OnBacked != null) OnBacked(); return (IntPtr)1; }
                if (bare && HasCode && VkCancel != 0 && k.vkCode == VkCancel) { if (OnEscaped != null) OnEscaped(); return (IntPtr)1; }
                if (bare && HasCode && VkRaw != 0 && k.vkCode == VkRaw) { if (OnEntered != null) OnEntered(); return (IntPtr)1; }
                if (bare && !sh && k.vkCode >= 65 && k.vkCode <= 90)           // a-z (Shift+letter -> uppercase EN passthrough)
                {
                    if (KeyUpEvent != null) KeyUpEvent(this, new KeyEventArgs((Keys)k.vkCode));
                    return (IntPtr)1;
                }
                if (bare && !sh && HasCode && k.vkCode == 0xBA && SemiAsCode)   // mspy shuangpin: ; is the ing final key
                {
                    if (OnSemi != null) OnSemi();
                    return (IntPtr)1;
                }
                if (bare && HasCode && VkFirst != 0 && k.vkCode == VkFirst) { if (OnSpaced != null) OnSpaced(0); return (IntPtr)1; }
                if (bare && HasCode && ((VkPageDown != 0 && k.vkCode == VkPageDown) || k.vkCode == 0x22
                        || (VkPageUp != 0 && k.vkCode == VkPageUp) || k.vkCode == 0x21))  // 配置键 + PgUp/PgDn 常驻
                {
                    if (OnPage != null) OnPage((k.vkCode == VkPageDown || k.vkCode == 0x22) ? 1 : -1);
                    return (IntPtr)1;
                }
                if (bare && !sh && HasCode && ((VkPickFirst != 0 && k.vkCode == VkPickFirst) || (VkPickLast != 0 && k.vkCode == VkPickLast)))   // 以词定字
                {
                    if (OnPickChar != null) OnPickChar(k.vkCode == VkPickFirst ? 0 : 1);
                    return (IntPtr)1;
                }
                if (bare)                                       // CN punctuation
                {
                    string pc = MapPunct(k.vkCode, sh);
                    if (pc != null) { if (OnPunct != null) OnPunct(pc); return (IntPtr)1; }
                }
            }
        } catch (Exception ex) { LogC("hook: " + ex); }
        return CallNextHookEx(hKeyboardHook, nCode, wParam, lParam);
    }
}

