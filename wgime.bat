    static void AddWubiWildcard(string keys, List<string> cands, Dictionary<string,string> wb)
    {
        if (wb == null) return;
        foreach (var kv in wb) {
            string k = kv.Key;
            if (k.Length != keys.Length) continue;
            bool ok = true;
            for (int i = 0; i < k.Length; i++) { if (keys[i] != 'z' && k[i] != keys[i]) { ok = false; break; } }
            if (!ok) continue;
            foreach (string t in kv.Value.Split(' ')) {
                if (cands.Count >= CandCap) return;
                if (t.Length > 0 && !cands.Contains(t)) cands.Add(t);
            }
        }
    }

    // ---------- v 模式: v+数字 -> 人民币大写金额 / 千分位 ----------
    static readonly char[] CnDigit = new char[] { '零', '壹', '贰', '叁', '肆', '伍', '陆', '柒', '捌', '玖' };
    static readonly string[] CnUnit4 = new string[] { "", "拾", "佰", "仟" };
    static readonly string[] CnBig = new string[] { "元", "万", "亿", "兆", "京" };

    static string UpperAmount(string ds)          // 1234 -> 壹仟贰佰叁拾肆元整 (null if out of range)
    {
        string s = ds.TrimStart('0');
        if (s.Length == 0) return "零元整";
        if (s.Length > 16) return null;           // beyond 京 (10^16)
        int head = s.Length % 4; if (head == 0) head = 4;
        int groups = (s.Length - head) / 4 + 1;
        var sb = new StringBuilder();
        bool pendingZero = false;                 // an all-zero group seen: needs a 零 before the next nonzero
        for (int g = 0; g < groups; g++) {
            int start = (g == 0) ? 0 : head + (g - 1) * 4;
            int len = (g == 0) ? head : 4;
            string grp = s.Substring(start, len);
            bool allZero = true; foreach (char c in grp) if (c != '0') { allZero = false; break; }
            if (allZero) { pendingZero = true; continue; }
            if (g > 0 && pendingZero && sb.Length > 0) sb.Append('零');
            pendingZero = false;
            bool grpZero = false;
            for (int i = 0; i < grp.Length; i++) {
                int d = grp[i] - '0';
                if (d == 0) { grpZero = true; continue; }
                if (grpZero) { sb.Append('零'); grpZero = false; }
                sb.Append(CnDigit[d]).Append(CnUnit4[grp.Length - 1 - i]);
            }
            if (g < groups - 1) sb.Append(CnBig[groups - 1 - g]);   // 万/亿/兆/京 per group; 元 appended once below
        }
        sb.Append("元整");
        return sb.ToString();
    }

    static string Thousands(string ds)            // 1234567 -> 1,234,567
    {
        string s = ds.TrimStart('0');
        if (s.Length == 0) return "0";
        var sb = new StringBuilder();
        for (int i = 0; i < s.Length; i++) {
            sb.Append(s[i]);
            int left = s.Length - 1 - i;
            if (left > 0 && left % 3 == 0) sb.Append(',');
        }
        return sb.ToString();
    }

    static string[] AddVMode(string code, List<string> cands)   // returns the strings it inserted (never learned)
    {
        if (code.Length < 2 || code[0] != 'v') return new string[0];
        string ds = code.Substring(1);
        foreach (char c in ds) if (c < '0' || c > '9') return new string[0];
        if (ds.Length > 16) return new string[0];
        var added = new List<string>();
        string th = Thousands(ds);
        if (!cands.Contains(th)) { cands.Insert(0, th); added.Add(th); }
        string up = UpperAmount(ds);
        if (up != null && !cands.Contains(up)) { cands.Insert(0, up); added.Add(up); }   // 大写金额 = candidate 1
        return added.ToArray();
    }

    // ---------- 码表导入 (convert common code tables into import_py/wb/ec.txt) ----------
    static bool IsPureAscii(string s) { if (s.Length == 0) return false; foreach (char c in s) if (c > 0x7F) return false; return true; }
    static bool IsAllDigits(string s) { if (s.Length == 0) return false; foreach (char c in s) if (c < '0' || c > '9') return false; return true; }
    static bool ValidCode(string s)              // ^[a-z][a-z0-9']{0,31}$
    {
        if (s.Length == 0 || s.Length > 32) return false;
        if (s[0] < 'a' || s[0] > 'z') return false;
        for (int i = 1; i < s.Length; i++) {
            char c = s[i];
            if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '\'')) return false;
        }
        return true;
    }
    static bool SkipLine(string t)               // empty / # ; // --- ... / yaml "key: value" header
    {
        t = t.Trim();
        if (t.Length == 0) return true;
        if (t[0] == '#' || t[0] == ';' || t.StartsWith("//") || t.StartsWith("---") || t.StartsWith("...")) return true;
        int ci = t.IndexOf(':');
        if (ci > 0 && (ci + 1 == t.Length || t[ci + 1] == ' ' || t[ci + 1] == '\t')) return true;
        return false;
    }
    static string ReadImportText(string path)    // null = too big / unreadable; UTF-8 strict -> GB18030 -> GBK
    {
        try {
            byte[] b = File.ReadAllBytes(path);
            if (b.Length > 64L * 1024 * 1024) return null;
            try { return new UTF8Encoding(false, true).GetString(b); }
            catch (DecoderFallbackException) {
                try { return Encoding.GetEncoding(54936).GetString(b); }
                catch (Exception) { return Encoding.GetEncoding(936).GetString(b); }
            }
        } catch { return null; }
    }
    static int DetectFormat(string[] lines)      // 1 = word-first (Rime), 2 = code-first, 0 = undetected
    {
        int wordFirst = 0, codeFirst = 0, seen = 0;
        foreach (string raw in lines) {
            if (seen >= 200) break;
            string t = raw.Trim();
            if (t.Length == 0 || SkipLine(t)) continue;
            seen++;
            if (t.IndexOf('\t') >= 0) { wordFirst++; continue; }
            int sp = t.IndexOf(' ');
            if (sp < 1) continue;
            if (IsPureAscii(t.Substring(0, sp))) codeFirst++; else wordFirst++;
        }
        if (wordFirst == 0 && codeFirst == 0) return 0;
        return wordFirst >= codeFirst ? 1 : 2;
    }
    static void ConvertFile(string text, int format, Dictionary<string,List<string>> acc,
                            ref int skipped, ref int truncatedCodes, ref int truncatedTotal)
    {
        foreach (string raw in text.Split('\n')) {
            string t = raw.Trim();
            if (t.Length == 0 || SkipLine(t)) continue;
            bool tab = t.IndexOf('\t') >= 0;
            var keep = new List<string>();
            foreach (string f in (tab ? t.Split('\t') : t.Split(' '))) {
                string ft = f.Trim(); if (ft.Length > 0) keep.Add(ft);
            }
            string[] fs = keep.ToArray();
            if (fs.Length < 2) { skipped++; continue; }
            if (IsAllDigits(fs[fs.Length - 1])) Array.Resize(ref fs, fs.Length - 1);   // trailing weight field
            if (fs.Length < 2) { skipped++; continue; }
            string code = null;
            var words = new List<string>();
            if (format == 1) {                        // word-first: word code [weight]
                string cd = fs[1].Trim().ToLower();
                if (ValidCode(cd)) { code = cd; words.Add(fs[0]); }
                else if (IsPureAscii(fs[0]) && ValidCode(fs[0].ToLower())) {   // EN word + CN meanings (ec style)
                    code = fs[0].Trim().ToLower();
                    for (int i = 1; i < fs.Length; i++) if (fs[i].Length > 0) words.Add(fs[i]);
                } else { skipped++; continue; }
            } else {                                  // code-first: code word word ...
                string cd = fs[0].Trim().ToLower();
                if (!ValidCode(cd)) { skipped++; continue; }
                code = cd;
                for (int i = 1; i < fs.Length; i++) if (fs[i].Length > 0) words.Add(fs[i]);
            }
            if (code == null || words.Count == 0) { skipped++; continue; }
            List<string> lst;
            if (!acc.TryGetValue(code, out lst)) {
                if (acc.Count >= 500000) { truncatedTotal++; continue; }
                lst = new List<string>(); acc[code] = lst;
            }
            foreach (string w in words) {
                if (w.Length == 0 || lst.Contains(w)) continue;
                if (w.IndexOf(' ') >= 0) { skipped++; continue; }   // words with inner spaces don't fit the space-separated format
                if (lst.Count >= 300) { truncatedCodes++; break; }
                lst.Add(w);
            }
        }
    }
    static Dictionary<string,List<string>> LoadImportBase(string path)   // existing import file -> accum (re-import is idempotent)
    {
        var acc = new Dictionary<string,List<string>>();
        try {
            if (!File.Exists(path)) return acc;
            foreach (string raw in File.ReadAllLines(path, Encoding.UTF8)) {
                string t = raw.Trim();
                if (t.Length < 3) continue;
                int sp = t.IndexOf(' ');
                if (sp < 1) continue;
                string k = t.Substring(0, sp).Trim().ToLower();
                var lst = new List<string>();
                foreach (string w in t.Substring(sp + 1).Split(' ')) if (w.Length > 0 && !lst.Contains(w)) lst.Add(w);
                if (k.Length > 0 && lst.Count > 0) acc[k] = lst;
            }
        } catch {}
        return acc;
    }
    static void WriteImportFile(string path, Dictionary<string,List<string>> acc)   // "code w1 w2 ..." per line, UTF-8 no BOM
    {
        var sb = new StringBuilder();
        var ks = acc.Keys.ToArray();
        Array.Sort(ks, StringComparer.Ordinal);
        foreach (string k in ks) {
            sb.Append(k);
            foreach (string w in acc[k]) { sb.Append(' '); sb.Append(w); }
            sb.Append('\n');
        }
        File.WriteAllText(path, sb.ToString(), new UTF8Encoding(false));
    }
    static int SuggestTarget(string fileName)    // 0=五笔 1=拼音 2=英汉
    {
        string n = (fileName ?? "").ToLower();
        if (n.Contains("wubi") || n.Contains("五笔") || n.StartsWith("wb") || n.Contains("_wb") || n.Contains("-wb")) return 0;
        if (n.Contains("english") || n.Contains("英汉") || n.StartsWith("ec") || n.Contains("_ec") || n.Contains("-ec")) return 2;
        if (n.Contains("pinyin") || n.Contains("拼音") || n.Contains("双拼") || n.Contains("全拼")
            || n.StartsWith("py") || n.Contains("_py") || n.Contains("-py")) return 1;
        if (n.EndsWith(".yaml") || n.EndsWith(".yml") || n.EndsWith(".dict")) return 0;   // Rime dict is usually wubi
        return 1;
    }
