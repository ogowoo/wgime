    void Toggle()
    {
        Hook.IsLocked = !Hook.IsLocked;
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
    }
    void SwitchMode()
    {
        mode = (mode + 1) % 4;
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
    }

    // ---------- hook events ----------
    void Hook_KeyUpEvent(object sender, KeyEventArgs e)
    {
        keys += e.KeyCode.ToString().ToLower();
        if (keys.Length > 32) keys = keys.Substring(0, 32);   // 32 covers the longest real English words
        Hook.HasCode = true;
        ShowCharatar();
    }

    void Hook_OnSemi()               // mspy shuangpin: ';' is the ing final key
    {
        keys += ";";
        if (keys.Length > 32) keys = keys.Substring(0, 32);
        Hook.HasCode = true;
        ShowCharatar();
    }

    void Hook_OnDigit(char d)        // v-mode: digit extends the code buffer
    {
        keys += d;
        if (keys.Length > 32) keys = keys.Substring(0, 32);
        Hook.HasCode = true;
        ShowCharatar();
    }

    void Hook_OnToggleTrad()         // Ctrl+Shift+F / tray: simplified <-> traditional output
    {
        Trad = !Trad;
        RefreshLabel();
        TrayTip(L("简繁输出", "Trad output"), Trad ? L("繁体输出已开启", "Traditional output ON") : L("简体输出", "Simplified output"), ToolTipIcon.Info);
    }

    void Hook_OnSpaced(int choose)      // space=0(first), digits=1..9
    {
        if (Shuangpin == 0 && keys == "vf" && symCat == 0) {           // vf panel root: digit picks a category, space ignored
            if (choose >= 1 && choose <= SymCats.Length) { symCat = choose; ShowCharatar(); }
            return;
        }
        int idx = page * PageSize + (choose > 0 ? choose - 1 : 0);
        if (idx < cands.Count) {
            if (symCat == 0 && !dynSet.Contains(cands[idx])) { Learn(keys, cands[idx]); RecordCommit(cands[idx], keys); }   // dynamic (rq/sj/xq) and panel symbols never learned
            Send(cands[idx]);
        }
        keys = ""; cands.Clear(); Hook.HasCode = false; page = 0; symCat = 0;
        RefreshLabel();
    }

    void Hook_OnPage(int d)
    {
        if (cands.Count == 0) return;
        int tp = (cands.Count + PageSize - 1) / PageSize;
        page = (page + d) % tp; if (page < 0) page += tp;
        RefreshLabel();
    }

    void Hook_OnPunct(string s)         // CN punct: commit pending code first (like modern IMEs)
    {
        if (Hook.HasCode && cands.Count > 0 && keys != "vf") { Learn(keys, cands[0]); RecordCommit(cands[0], keys); Send(cands[0]); }   // vf panel never auto-commits
        if (Hook.HasCode) { keys = ""; cands.Clear(); Hook.HasCode = false; page = 0; symCat = 0; RefreshLabel(); }
        Send(s);
    }

    void Hook_OnBacked()
    {
        if (symCat > 0) { symCat = 0; ShowCharatar(); return; }   // backspace inside a category -> back to the root menu
        if (keys.Length > 0) keys = keys.Substring(0, keys.Length - 1);
        if (keys.Length == 0) { cands.Clear(); Hook.HasCode = false; }
        ShowCharatar();
    }

    void Hook_OnEscaped()
    {
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
    }

    void Hook_OnEntered()               // commit raw code (vf panel: Enter just closes it)
    {
        string raw = keys;
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
        if (raw.Length > 0 && raw != "vf") Send(raw);
    }

    void Hook_OnToggled() { Toggle(); }
    void Hook_OnModeSwitched() { SwitchMode(); }

    // ---------- candidates ----------
    bool exactWubi, extendable;

    void AddCands(string val)          // candidates are ALWAYS space-separated
    {
        foreach (string t in val.Split(' ')) {
            if (cands.Count >= CandCap) break;
            if (t.Length > 0 && !cands.Contains(t)) cands.Add(t);
        }
    }

    void AddFromDict(Dictionary<string,string> d, string[] ks, string[] vs, bool isWubi, string code)
    {
        string exact;
        if (d.TryGetValue(code, out exact)) {
            if (isWubi) exactWubi = true;
            AddCands(exact);
        }
        if (ks == null) return;
        // binary search: first sorted key >= input, then walk the prefix range
        int lo = 0, hi = ks.Length - 1;
        while (lo <= hi) { int mid = (lo + hi) / 2; if (string.CompareOrdinal(ks[mid], code) < 0) lo = mid + 1; else hi = mid - 1; }
        while (lo < ks.Length && ks[lo].StartsWith(code) && cands.Count < CandCap) {
            if (ks[lo] != code) {
                extendable = true;
                foreach (string t in vs[lo].Split(' ')) {   // prefix matches: single chars only, no words
                    if (cands.Count >= CandCap) break;
                    if (t.Length == 1 && !cands.Contains(t)) cands.Add(t);
                }
            }
            lo++;
        }
    }

    void AddAcro(string code)          // 简拼: zg -> 中国 (initials of each char's pinyin)
    {
        if (code.Length < 2 || Acro == null) return;
        List<string> lst;
        if (Acro.TryGetValue(code, out lst))
            foreach (string w in lst) { if (cands.Count >= CandCap) break; if (!cands.Contains(w)) cands.Add(w); }
    }

