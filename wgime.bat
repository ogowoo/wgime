                          + L("  五笔: ", "  wubi: ") + WbDict.Count
                          + L("  英汉: ", "  ec: ") + EcDict.Count
                          + L("  Shift=开关 Ctrl+`=模式", "  Shift=on/off Ctrl+`=mode"), ToolTipIcon.Info); } catch {}
                    }); } catch {}
                } catch (Exception ex) {
                    try { File.AppendAllText(Path.Combine(DataDir, "mb_error.log"),
                        "[" + DateTime.Now.ToString("s") + "] " + ex + "\n", Encoding.UTF8); } catch {}
                }
            });
            Application.Run(form);
        }
    }
