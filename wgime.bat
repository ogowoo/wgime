    void BakeTables()
    {
        if (inDialog) return;
        inDialog = true;
        bool was = Hook.IsLocked;
        keys = ""; cands.Clear(); Hook.HasCode = false; Hook.IsLocked = false;
        RefreshLabel();
        try {
            if (!DictsReady || PyDict == null || WbDict == null || EcDict == null) {
                TrayTip(L("固化码表", "Bake Tables"), L("词库还在加载中，请稍后再试", "Dictionaries still loading, try again in a moment"), ToolTipIcon.Warning);
                return;
            }
            string pyS = SerializeDict(PyDict), wbS = SerializeDict(WbDict), ecS = SerializeDict(EcDict);
            using (var dlg = new BakeDialog(pyS.Length, wbS.Length, ecS.Length)) {
                if (dlg.ShowDialog() != DialogResult.OK) return;
                bool bakePy = dlg.BakePy, bakeWb = dlg.BakeWb, bakeEc = dlg.BakeEc, delSrc = dlg.DeleteSources;
                if (!bakePy && !bakeWb && !bakeEc) return;
                System.Threading.Tasks.Task.Run(delegate {
                    try {
                        string bat = File.ReadAllText(BatPath, Encoding.UTF8);
                        string work = bat;
                        int baked = 0;
                        if (bakePy) { string r; if (!ReplaceHereString(work, "pyData", pyS, out r)) throw new Exception("pyData here-string not found"); work = r; baked += PyDict.Count; }
                        if (bakeWb) { string r; if (!ReplaceHereString(work, "wbData", wbS, out r)) throw new Exception("wbData here-string not found"); work = r; baked += WbDict.Count; }
                        if (bakeEc) { string r; if (!ReplaceHereString(work, "ecData", ecS, out r)) throw new Exception("ecData here-string not found"); work = r; baked += EcDict.Count; }
                        string bakPath = MakeBakPath(BatPath);
                        File.WriteAllText(bakPath, bat, new UTF8Encoding(false));   // backup is mandatory: fail here and the bat stays untouched
                        PruneBaks(BatPath, 7);                                      // rolling backups: keep the newest 7
                        File.WriteAllText(BatPath, work, new UTF8Encoding(false));
                        if (delSrc) {                                    // only after a successful bat write
                            if (bakePy) { DeleteQuiet(Path.Combine(BatDir, "py.txt")); DeleteQuiet(Path.Combine(BatDir, "import_py.txt")); }
                            if (bakeWb) { DeleteQuiet(Path.Combine(BatDir, "wb.txt")); DeleteQuiet(Path.Combine(BatDir, "import_wb.txt")); }
                            if (bakeEc) { DeleteQuiet(Path.Combine(BatDir, "ec.txt")); DeleteQuiet(Path.Combine(BatDir, "import_ec.txt")); }
                        }
                        string msg = L("已固化 ", "Baked ") + baked + L(" 条到内置码表", " entries into built-in tables")
                                   + L("  备份: ", "  backup: ") + Path.GetFileName(bakPath) + L("  (保留最近7份)", "  (keeping last 7)")
                                   + (delSrc ? L("  源txt已删除", "  source txt deleted") : L("  现在可删除目录中的txt", "  you may delete the txt files now"));
                        try { BeginInvoke((Action)delegate { TrayTip(L("固化完成", "Bake done"), msg, ToolTipIcon.Info); }); } catch {}
                    } catch (Exception ex) {
                        try { BeginInvoke((Action)delegate { TrayTip(L("固化失败", "Bake failed"), ex.Message, ToolTipIcon.Error); }); } catch {}
                    }
                });
            }
        } finally {
            Hook.IsLocked = was; inDialog = false; RefreshLabel();
        }
    }

