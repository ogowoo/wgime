    void Toggle()
    {
        Hook.IsLocked = !Hook.IsLocked;
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
    }
    void SwitchMode()
    {
        mode = (mode + 1) % 4;
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
    }
    void SetMode(int m)                                 // tray mode submenu: jump straight to a mode
    {
        if (mode == m) return;
        mode = m;
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
    }
    void RefreshMenuChecks()                            // tray menu opening: sync checkmarks with live state
    {
        if (miOnOff == null) return;
        miOnOff.Checked = Hook.IsLocked;
        for (int i = 0; i < miModes.Length; i++) miModes[i].Checked = (mode == i);
        miCode.Checked = ShowCode;
        miTrad.Checked = Trad;
        miFollow.Checked = FollowCaret;
        miHideIdle.Checked = HideIdle;
        string app = ForegroundProcessName();
        int cur;
        miAppPaste.Checked = AppModes != null && AppModes.TryGetValue(app, out cur) && cur == 1;
        miAppKeyfix.Checked = EffectiveKeyfix();
    }
