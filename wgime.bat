@echo off
rem ============================================================
rem  WgIme - simple overlay IME (pinyin / wubi / mixed), Win11
rem  bat bootstrap -> PowerShell reads itself -> Add-Type in-memory
rem  compile C# (WH_KEYBOARD_LL hook + SendKeys). No exe, no reg.
rem  Architecture follows cnblogs.com/yswenli/p/6528447.html
rem
rem  Keys:
rem    Shift tap          : IME on/off (shift alone, no other key)
rem    Ctrl+`             : switch mode mixed -> pinyin -> wubi -> translate
rem    translate mode     : type EN word -> CN meanings; type pinyin/简拼
rem                          of a CN word -> EN translations (pick to commit)
rem    Shift+letter       : uppercase EN passthrough
rem    a-z type code, 1-9 pick, Space=1st, Enter=raw code
rem    = / - or PgDn/PgUp : candidate pages, Backspace delete, Esc clear
rem    CN punctuation auto-mapped (, . ; : ' " ? < > \ [ ] $)
rem    Ctrl+Alt+C         : make word from clipboard (copy 2-8 hanzi first)
rem    auto word creation : consecutive single-char picks become a word
rem  Features: word frequency learning (userdict.txt), acronym pinyin
rem    (zg -> 中国), fuzzy pinyin (zh/z, ang/an, n/l...), draggable bar
rem    (position saved), async dict load, binary cache (wgime.mb),
rem    user words (userwords.txt), EN-CN translate mode.
rem  Extend dict: put py.txt / wb.txt / ec.txt next to this bat
rem    each line: code cand1 cand2 ... (candidates separated by SPACE)
rem  Import: tray menu 导入码表 converts common code tables (Rime
rem    dict.yaml / word-first / code-first txt) into import_py.txt /
rem    import_wb.txt / import_ec.txt in this folder - auto-loaded on
rem    startup with the same logic as py/wb/ec.txt, hot-reloaded live
rem  Bake: tray menu 固化码表 writes the merged dictionaries back into
rem    the embedded here-strings (timestamped wgime.bat.bak-* backups,
rem    newest 7 kept), so the txt files can then be deleted safely
rem  Config: config.txt next to the bat: fuzzy pairs, phrases (code<TAB>
rem    text), showcode=1 (reverse code hints), paste=on/auto/off
rem    (on=clipboard paste, default: immune to system-IME interference)
rem  Extras: [ ] pick first/last char of top candidate, rq/sj/xq dynamic
rem    date/time/weekday candidates, wubi z wildcard lookup
rem  Errors are logged to %TEMP%\WgIme_error.log
rem ============================================================
set "WGIME_PATH=%~f0"
set "WGIME_DIR=%~dp0"
if /i "%~1"=="_h" goto :main
rem WGIME_DEBUG=1: keep console visible so startup errors can be seen on locked-down machines
if defined WGIME_DEBUG (
  powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '%~f0' -ArgumentList '_h'"
) else (
  powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "Start-Process -FilePath '%~f0' -ArgumentList '_h' -WindowStyle Hidden"
)
exit /b
:main
if defined WGIME_DEBUG (
  powershell.exe -STA -NoProfile -NoLogo -ExecutionPolicy Bypass -Command "try { $s=[IO.File]::ReadAllText($env:WGIME_PATH,[Text.Encoding]::UTF8); $i=$s.LastIndexOf('###PWSH###'); $p=$s.Substring($i+10); Invoke-Expression $p } catch { [IO.File]::WriteAllText((Join-Path $env:TEMP 'WgIme_error.log'), ($_ | Out-String)); Write-Host ($_ | Out-String) -ForegroundColor Red; Read-Host 'press ENTER to exit' }"
) else (
  powershell.exe -STA -NoProfile -NoLogo -WindowStyle Hidden -ExecutionPolicy Bypass -Command "try { $s=[IO.File]::ReadAllText($env:WGIME_PATH,[Text.Encoding]::UTF8); $i=$s.LastIndexOf('###PWSH###'); $p=$s.Substring($i+10); Invoke-Expression $p } catch { [IO.File]::WriteAllText((Join-Path $env:TEMP 'WgIme_error.log'), ($_ | Out-String)); Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.MessageBox]::Show(($_ | Out-String),'WgIme Error') | Out-Null }"
)
exit /b
###PWSH###
# ================= PowerShell bootstrap: extract embedded C# and compile in memory =================
$wgLog = Join-Path $env:TEMP 'WgIme_error.log'
function WgLog([string]$m) { try {
    if (Test-Path $wgLog) { $len = (Get-Item $wgLog).Length; if ($len -gt 1MB) { Move-Item $wgLog ($wgLog + '.old') -Force -ErrorAction SilentlyContinue } }
    [IO.File]::AppendAllText($wgLog, ("[{0}] {1}`r`n" -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $m), [Text.Encoding]::UTF8)
} catch {} }
WgLog "---- WgIme starting ----"
WgLog ("OS: " + [Environment]::OSVersion.VersionString + " 64bit:" + [Environment]::Is64BitOperatingSystem)
WgLog ("PS: " + $PSVersionTable.PSVersion.ToString() + " CLR: " + $PSVersionTable.CLRVersion.ToString())
WgLog ("LanguageMode: " + $ExecutionContext.SessionState.LanguageMode)
WgLog ("User: " + [Security.Principal.WindowsIdentity]::GetCurrent().Name)
try {
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
WgLog "WinForms assemblies loaded"

