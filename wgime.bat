    protected override void OnLoad(EventArgs e)
    {
        base.OnLoad(e);
        Hook.Start();
        if (!Hook.Installed)
            TrayTip(L("WgIme 已启动", "WgIme started"),
                    L("钩子失败, 见 %TEMP%\\WgIme_error.log", "hook FAILED, see %TEMP%\\WgIme_error.log"), ToolTipIcon.Error);
    }

