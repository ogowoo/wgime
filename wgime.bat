    static string SpSegment(string seg, int scheme)         // one 2-key syllable -> full pinyin
    {
        string[][] rules = SpRules[scheme - 1];
        foreach (string[] r in rules) seg = Regex.Replace(seg, r[0], r[1]);
        if (seg.Length == 2 && seg[0] == seg[1] && (seg[0] == 'a' || seg[0] == 'o' || seg[0] == 'e'))
            seg = seg.Substring(0, 1);                      // zero-initial single vowel: aa/oo/ee -> a/o/e
        if (scheme != 1 && seg == "r") seg = "er";          // ziranma/ms: er is typed as a single r
        return seg.Replace("üe", "ue").Replace("ü", "v");   // built-in dict convention: lü->lv, lüe->lue
    }

    public static string ShuangpinExpand(string keys)       // typed keys -> full pinyin prefix (pairs + trailing initial)
    {
        int scheme = Shuangpin;
        if (scheme < 1 || scheme > 3 || keys.Length == 0) return keys;
        var sb = new StringBuilder();
        int i = 0;
        while (i < keys.Length) {
            int n = (i + 1 < keys.Length) ? 2 : 1;
            sb.Append(SpSegment(keys.Substring(i, n), scheme));
            i += n;
        }
        return sb.ToString();
    }

