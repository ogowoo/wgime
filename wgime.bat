            new string[]{ @"(\w)y", "$1v" }, new string[]{ @"([dtnlgkhvuirzcs])o", "$1uo" }, new string[]{ @"(\w)p", "$1un" },
            new string[]{ @"([jqx])s", "$1iong" }, new string[]{ @"(\w)s", "$1ong" }, new string[]{ @"([jqxnl])d", "$1iang" },
