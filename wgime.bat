                foreach (var a in tab.Actions) {
                    var b = new Button { Text = a.Name, Tag = a, Width = 410, Height = 38, TextAlign = ContentAlignment.MiddleLeft, Margin = new Padding(3) };
                    b.Click += RunAction;
                    flow.Controls.Add(b);
                }
                page.Controls.Add(flow);
                tc.TabPages.Add(page);
            }
            log = new TextBox { Dock = DockStyle.Bottom, Height = 120, Multiline = true, ReadOnly = true, ScrollBars = ScrollBars.Vertical, Font = new Font("Consolas", 9F), BackColor = SystemColors.Window };
