    readonly HashSet<string> appSet = new HashSet<string>();   // app-launcher candidates: launch instead of commit, never learned
    public static Dictionary<string,string[]> Apps;            // app launcher: code -> [name, command, args] (command "builtin:calc" = embedded calculator)
