    void AddEcPrefix()                 // EN -> CN: english words starting with code
    {
        if (EcKeys == null) return;
        int lo = 0, hi = EcKeys.Length - 1;
        while (lo <= hi) { int mid = (lo + hi) / 2; if (string.CompareOrdinal(EcKeys[mid], keys) < 0) lo = mid + 1; else hi = mid - 1; }
        while (lo < EcKeys.Length && EcKeys[lo].StartsWith(keys) && cands.Count < CandCap) {
            if (EcKeys[lo] != keys) AddCands(EcVals[lo]);
            lo++;
        }
    }

    void AddTranslate()                // dictionary mode: EN->CN direct, CN->EN via pinyin/简拼
    {
        string exact;
        if (EcDict != null && EcDict.TryGetValue(keys, out exact)) AddCands(exact);
        AddEcPrefix();
        if (CeDict == null) return;
        var cnWords = new List<string>();
        if (PyDict != null && PyDict.TryGetValue(keys, out exact))
            foreach (string w in exact.Split(' ')) if (!cnWords.Contains(w)) cnWords.Add(w);
        if (Acro != null) {
            List<string> lst;
            if (Acro.TryGetValue(keys, out lst)) foreach (string w in lst) if (!cnWords.Contains(w)) cnWords.Add(w);
        }
        foreach (string cn in cnWords) {
            string en;
            if (CeDict.TryGetValue(cn, out en)) AddCands(en);
        }
    }

    static Dictionary<string,string> BuildReverse(Dictionary<string,string> ec)   // CN word -> EN words
    {
        var rev = new Dictionary<string,List<string>>();
        foreach (var kv in ec) foreach (string cn in kv.Value.Split(' ')) {
            if (cn.Length == 0) continue;
            List<string> lst;
            if (!rev.TryGetValue(cn, out lst)) { lst = new List<string>(); rev[cn] = lst; }
            if (lst.Count < 8 && !lst.Contains(kv.Key)) lst.Add(kv.Key);
        }
        var d = new Dictionary<string,string>(rev.Count);
        foreach (var kv in rev) d[kv.Key] = string.Join(" ", kv.Value);
        return d;
    }

