    static void SaveConfigKey(string key, string value)   // tray toggle persists a config key (showcode/trad...) into config.txt (keep comments/other keys)
    {
        try {
            string f = Path.Combine(BatDir, "config.txt");
            string t = File.Exists(f) ? File.ReadAllText(f, Encoding.UTF8) : DefaultConfigText();
            string nl = t.Contains("\r\n") ? "\r\n" : "\n";
            string[] lines = t.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None);
            string kv = key + " = " + value;
            bool found = false;
            for (int i = 0; i < lines.Length; i++) {
                string s = lines[i].Trim();
                if (s.Length == 0 || s[0] == ';' || s[0] == '#') continue;
                int eq = s.IndexOf('=');
                if (eq > 0 && s.Substring(0, eq).Trim().Equals(key, StringComparison.OrdinalIgnoreCase)) {
                    lines[i] = kv; found = true; break;
                }
            }
            if (!found) {                        // no such key: insert after the fuzzy block (template order), else at end
                int ins = -1;
                for (int i = 0; i < lines.Length; i++) {
                    string s = lines[i].Trim();
                    if (s.Length > 0 && !s.StartsWith(";") && !s.StartsWith("#")) {
                        int eq = s.IndexOf('=');
                        if (eq > 0 && s.Substring(0, eq).Trim().Equals("fuzzy", StringComparison.OrdinalIgnoreCase)) ins = i + 1;
                    }
                }
                var list = new List<string>(lines);
                if (ins < 0) ins = list.Count;
                list.Insert(ins, kv);
                lines = list.ToArray();
            }
            File.WriteAllText(f, string.Join(nl, lines), new UTF8Encoding(false));
        } catch {}
    }

    // ---------- 动态候选 / 自定义短语 / 五笔 z 通配符 ----------
    static string[] AddDynamic(string code, List<string> cands)   // returns the strings it inserted
    {
        string[] dyn = null;
        DateTime n = DateTime.Now;
        if (code == "rq") dyn = new string[] { n.ToString("yyyy-MM-dd"), n.ToString("yyyy年M月d日"), n.ToString("yyyy/MM/dd") };
        else if (code == "sj") dyn = new string[] { n.ToString("HH:mm"), n.ToString("HH:mm:ss"), n.ToString("yyyy-MM-dd HH:mm") };
        else if (code == "xq") dyn = new string[] { "星期" + "日一二三四五六"[(int)n.DayOfWeek], "周" + "日一二三四五六"[(int)n.DayOfWeek] };
        if (dyn == null) return new string[0];
        var added = new List<string>();
        for (int i = dyn.Length - 1; i >= 0; i--) if (!cands.Contains(dyn[i])) { cands.Insert(0, dyn[i]); added.Add(dyn[i]); }
        return added.ToArray();
    }

