        string PluginDir() { return Path.Combine(BatDir, "plugins"); }

        void RefreshList()
        {
            list.BeginUpdate();
            list.Items.Clear();
            if (Apps != null) {
                foreach (var kv in Apps) {
                    bool step = kv.Value[1].StartsWith("plugin:");
                    bool code = kv.Value[1].StartsWith("codeplugin:");
                    if (!step && !code) continue;
                    string file = kv.Value[1].Substring(step ? 7 : 11);
                    string status;
                    if (step) {
                        ToolAction a;
                        status = (PluginActions != null && PluginActions.TryGetValue(file, out a))
                            ? L("正常", "OK") + " (" + a.Steps.Count + L(" 步", " steps") + ")"
                            : L("解析失败", "parse error");
                    } else {
                        PluginCode pc;
                        status = (PluginCodeCache != null && PluginCodeCache.TryGetValue(file, out pc))
                            ? (pc.Error != null ? L("编译失败", "compile error") : L("正常", "OK"))
                            : L("未编译", "not compiled");
                    }
                    var it = new ListViewItem(kv.Value[0]);
                    it.SubItems.Add(kv.Key);
