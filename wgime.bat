    {
        if (EmojiImgs == null) {
            var d = new Dictionary<string,Bitmap>();
            for (int i = 0; i < EmojiChars.Length && i < EmojiPngs.Length; i++) {
                try { using (var ms = new System.IO.MemoryStream(Convert.FromBase64String(EmojiPngs[i]))) using (var img = Image.FromStream(ms)) d[EmojiChars[i]] = new Bitmap(img); } catch {}
