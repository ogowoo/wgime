        menu.Items.Add(L("这个程序改用剪贴板上屏", "This app: paste via clipboard"), null, delegate { ToggleAppPasteMode(); });
        menu.Items.Add(L("简繁输出  (Ctrl+Shift+F)", "Trad output  (Ctrl+Shift+F)"), null, delegate { Hook_OnToggleTrad(); });
        menu.Items.Add(L("退出", "Exit"), null, delegate { Application.Exit(); });
        tray.ContextMenuStrip = menu;

        Hook.KeyUpEvent += Hook_KeyUpEvent;
        Hook.OnSpaced += Hook_OnSpaced;
        Hook.OnBacked += Hook_OnBacked;
        Hook.OnEscaped += Hook_OnEscaped;
        Hook.OnEntered += Hook_OnEntered;
        Hook.OnCtrlBackquote += delegate { if (!inDialog) SwitchMode(); };
        Hook.OnShiftTap += Hook_OnShiftTap;
        Hook.OnPage += Hook_OnPage;
        Hook.OnPunct += Hook_OnPunct;
        Hook.OnMakeWord += delegate { if (!inDialog) MakeWordFromClipboard(); };
        Hook.OnPickChar += Hook_OnPickChar;
        Hook.OnSemi += Hook_OnSemi;
        Hook.OnDigit += Hook_OnDigit;
        Hook.OnToggleTrad += Hook_OnToggleTrad;
        RefreshLabel();
    }

    void Hook_OnShiftTap() { if (!inDialog) Toggle(); }

    void Hook_OnPickChar(int firstLast)     // [ = first char, ] = last char of the top candidate
    {
        if (cands.Count == 0 || keys == "vf") { Send(firstLast == 0 ? "【" : "】"); return; }   // no candidates / vf panel -> CN punctuation
        string w = cands[0];
        string code = keys;
        string c = w.Length == 1 ? w : (firstLast == 0 ? w.Substring(0, 1) : w.Substring(w.Length - 1, 1));
        keys = ""; cands.Clear(); Hook.HasCode = false; page = 0;
        RefreshLabel();
        if (!dynSet.Contains(w)) Learn(code, w);   // dynamic candidates never learned; whole word gets the credit otherwise
        Send(c);
    }

