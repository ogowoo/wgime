    void Hook_OnShiftTap() { if (!inDialog) Toggle(); }

    void Hook_OnPickChar(int firstLast)     // [ = first char, ] = last char of the top candidate
    {
        if (cands.Count == 0 || keys == "vf") { Send(firstLast == 0 ? "【" : "】"); return; }   // no candidates / vf panel -> CN punctuation
        string w = cands[0];
        string code = keys;
        string c = w.Length == 1 ? w : (firstLast == 0 ? w.Substring(0, 1) : w.Substring(w.Length - 1, 1));
        keys = ""; cands.Clear(); Hook.HasCode = false; page = 0;
        RefreshLabel();
        if (!dynSet.Contains(w)) Learn(code, w);   // dynamic candidates never learned; whole word gets the credit otherwise
        Send(c);
    }

    protected override CreateParams CreateParams {
        get {
            const int WS_EX_NOACTIVATE=0x08000000, WS_EX_TOOLWINDOW=0x80, WS_EX_TOPMOST=0x8;
            CreateParams cp = base.CreateParams;
            cp.ExStyle |= WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW | WS_EX_TOPMOST;
            return cp;
        }
    }

    protected override void OnLoad(EventArgs e)
    {
        base.OnLoad(e);
        Hook.Start();
        if (!Hook.Installed)
            TrayTip(L("WgIme 已启动", "WgIme started"),
                    L("钩子失败, 见 %TEMP%\\WgIme_error.log", "hook FAILED, see %TEMP%\\WgIme_error.log"), ToolTipIcon.Error);
    }

    protected override void OnFormClosed(FormClosedEventArgs e)
    {
        Hook.Stop();
        tray.Visible = false;
        base.OnFormClosed(e);
    }

    void Toggle()
    {
        Hook.IsLocked = !Hook.IsLocked;
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
    }
    void SwitchMode()
    {
        mode = (mode + 1) % 4;
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
    }
    void SetMode(int m)                                 // tray mode submenu: jump straight to a mode
    {
        if (mode == m) return;
        mode = m;
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
    }
    void RefreshMenuChecks()                            // tray menu opening: sync checkmarks with live state
    {
        if (miOnOff == null) return;
        miOnOff.Checked = Hook.IsLocked;
        for (int i = 0; i < miModes.Length; i++) miModes[i].Checked = (mode == i);
        miCode.Checked = ShowCode;
        miTrad.Checked = Trad;
        miFollow.Checked = FollowCaret;
        miHideIdle.Checked = HideIdle;
        string app = ForegroundProcessName();
        int cur;
        miAppPaste.Checked = AppModes != null && AppModes.TryGetValue(app, out cur) && cur == 1;
        miAppKeyfix.Checked = EffectiveKeyfix();
    }
    void OpenConfigFile() { try { Process.Start(new ProcessStartInfo { FileName = Path.Combine(BatDir, "config.txt"), UseShellExecute = true }); } catch {} }
    void OpenDataDir()    { try { Process.Start(new ProcessStartInfo { FileName = DataDir, UseShellExecute = true }); } catch {} }

    // ---------- hook events ----------
    void Hook_KeyUpEvent(object sender, KeyEventArgs e)
    {
        keys += e.KeyCode.ToString().ToLower();
        if (keys.Length > 32) keys = keys.Substring(0, 32);   // 32 covers the longest real English words
        Hook.HasCode = true;
        ShowCharatar();
    }

    void Hook_OnSemi()               // mspy shuangpin: ';' is the ing final key
    {
        keys += ";";
        if (keys.Length > 32) keys = keys.Substring(0, 32);
        Hook.HasCode = true;
        ShowCharatar();
    }

    void Hook_OnDigit(char d)        // v-mode: digit extends the code buffer
    {
        keys += d;
        if (keys.Length > 32) keys = keys.Substring(0, 32);
        Hook.HasCode = true;
        ShowCharatar();
    }

    void Hook_OnToggleTrad()         // Ctrl+Shift+F / tray: simplified <-> traditional output
    {
        Trad = !Trad;
        SaveConfigKey("trad", Trad ? "1" : "0");   // persist so the choice survives restart (same as showcode)
        RefreshLabel();
    }

    void Hook_OnSpaced(int choose)      // space=0(first), digits=1..9
    {
        if (Shuangpin == 0 && keys == "vf" && symCat == 0) {           // vf panel root: digit picks a category, space ignored
            if (choose >= 1 && choose <= SymCats.Length) { symCat = choose; ShowCharatar(); }
            return;
        }
        int idx = page * PageSize + (choose > 0 ? choose - 1 : 0);
        if (idx < cands.Count) {
            if (appSet.Contains(cands[idx])) {                       // app launcher: launch the app, no commit, no learning
                LaunchApp(keys);
            } else {
                if (symCat == 0 && !dynSet.Contains(cands[idx])) { Learn(keys, cands[idx]); RecordCommit(cands[idx], keys); }   // dynamic (rq/sj/xq) and panel symbols never learned
                Send(cands[idx]);
            }
        }
        keys = ""; cands.Clear(); Hook.HasCode = false; page = 0; symCat = 0;
        RefreshLabel();
    }

    void Hook_OnPage(int d)
    {
        if (cands.Count == 0) return;
        int tp = (cands.Count + PageSize - 1) / PageSize;
        page = (page + d) % tp; if (page < 0) page += tp;
        RefreshLabel();
    }

    void Hook_OnPunct(string s)         // CN punct: commit pending code first (like modern IMEs)
    {
        if (Hook.HasCode && cands.Count > 0 && keys != "vf") { Learn(keys, cands[0]); RecordCommit(cands[0], keys); Send(cands[0]); }   // vf panel never auto-commits
        if (Hook.HasCode) { keys = ""; cands.Clear(); Hook.HasCode = false; page = 0; symCat = 0; RefreshLabel(); }
        Send(s);
    }

    void Hook_OnBacked()
    {
        if (symCat > 0) { symCat = 0; ShowCharatar(); return; }   // backspace inside a category -> back to the root menu
        if (keys.Length > 0) keys = keys.Substring(0, keys.Length - 1);
        if (keys.Length == 0) { cands.Clear(); Hook.HasCode = false; }
        ShowCharatar();
    }

    void Hook_OnEscaped()
    {
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
    }

    void Hook_OnEntered()               // commit raw code (vf panel: Enter just closes it)
    {
        string raw = keys;
        keys = ""; cands.Clear(); Hook.HasCode = false; symCat = 0;
        RefreshLabel();
        if (raw.Length > 0 && raw != "vf") Send(raw);
    }

    void Hook_OnToggled() { Toggle(); }
    void Hook_OnModeSwitched() { SwitchMode(); }

    // ---------- candidates ----------
    bool exactWubi, extendable;

    void AddCands(string val)          // candidates are ALWAYS space-separated
    {
        foreach (string t in val.Split(' ')) {
            if (cands.Count >= CandCap) break;
            if (t.Length > 0 && !cands.Contains(t)) cands.Add(t);
        }
    }

    void AddFromDict(Dictionary<string,string> d, string[] ks, string[] vs, bool isWubi, string code)
    {
        string exact;
        if (d.TryGetValue(code, out exact)) {
            if (isWubi) exactWubi = true;
            AddCands(exact);
        }
        if (ks == null) return;
        // binary search: first sorted key >= input, then walk the prefix range
        int lo = 0, hi = ks.Length - 1;
        while (lo <= hi) { int mid = (lo + hi) / 2; if (string.CompareOrdinal(ks[mid], code) < 0) lo = mid + 1; else hi = mid - 1; }
        while (lo < ks.Length && ks[lo].StartsWith(code) && cands.Count < CandCap) {
            if (ks[lo] != code) {
                extendable = true;
                foreach (string t in vs[lo].Split(' ')) {   // prefix matches: single chars only, no words
                    if (cands.Count >= CandCap) break;
                    if (t.Length == 1 && !cands.Contains(t)) cands.Add(t);
                }
            }
            lo++;
        }
    }

    void AddAcro(string code)          // 简拼: zg -> 中国 (initials of each char's pinyin)
    {
        if (code.Length < 2 || Acro == null) return;
        List<string> lst;
        if (Acro.TryGetValue(code, out lst))
            foreach (string w in lst) { if (cands.Count >= CandCap) break; if (!cands.Contains(w)) cands.Add(w); }
    }

    static readonly string[][] DefaultFuzzyPairs = new string[][] {
        new string[]{"zh","z"}, new string[]{"ch","c"}, new string[]{"sh","s"},
        new string[]{"ang","an"}, new string[]{"eng","en"}, new string[]{"ing","in"},
        new string[]{"n","l"}
    };
    static string[][] FuzzyPairs = DefaultFuzzyPairs;        // overridable via config.txt (fuzzy = ...)

    // ---------- 双拼 (shuangpin): 两键音节还原为全拼。规则取自 rime double-pinyin 的 preedit_format (小鹤/自然码/微软) ----------
    public static int Shuangpin;                             // 0=off 1=xiaohe 2=ziranma 3=ms  (config: shuangpin = ...)
    public static bool StartOn;                              // config: starton = 1/0 (IME on/off at startup)
    static readonly string[][][] SpRules = new string[][][] {
        new string[][] {   // 1: 小鹤 (double_pinyin_flypy)
            new string[]{ @"([bpmfdtnljqx])n", "$1iao" }, new string[]{ @"(\w)g", "$1eng" }, new string[]{ @"(\w)q", "$1iu" },
            new string[]{ @"(\w)w", "$1ei" }, new string[]{ @"([dtnlgkhjqxyvuirzcs])r", "$1uan" }, new string[]{ @"(\w)t", "$1ve" },
            new string[]{ @"(\w)y", "$1un" }, new string[]{ @"([dtnlgkhvuirzcs])o", "$1uo" }, new string[]{ @"(\w)p", "$1ie" },
